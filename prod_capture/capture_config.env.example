# === 捕获目标:真实 eval_server(代理转发到这里) ===
EVAL_SERVER_HOST=192.168.1.50
EVAL_SERVER_PORT=5001

# === 代理监听 ===
PROXY_LISTEN_PORT=15001
# 改写入 dimensions.api_url 的代理地址(backend 进程要能访问到代理;代理与 backend 同机用 127.0.0.1)
PROXY_URL=http://127.0.0.1:15001

# === 只改指向本 eval_server 的维度:api_url 含此子串才改;留空=改所有非空 api_url ===
MATCH_HOST=192.168.1.50

# === 后端 DB(用于自动改/回滚 dimensions.api_url) ===
# 留空则自动读 Intelligent-Audio-TEST/backend/.env
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# === 后端日志(停止时一并打包;留空跳过) ===
BACKEND_APPLOG=Intelligent-Audio-TEST/logs/app.log
BACKEND_STDOUT=
