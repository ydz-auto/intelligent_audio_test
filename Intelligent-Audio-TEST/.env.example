# ===== 本地开发环境配置 =====
# 复制此文件为 .env，按需修改

# PostgreSQL
DATABASE_URL=postgresql://intelligent_audio_test:intelligent_audio_test666@localhost:5432/intelligent_audio_test

# Redis
REDIS_URL=redis://localhost:6379

# OSS（开发环境 = MinIO，生产环境 = AWS S3）
# 开发环境指向本地 MinIO
OSS_ENDPOINT=http://localhost:9000
OSS_ACCESS_KEY=minio
OSS_SECRET_KEY=minio123
OSS_REGION=us-east-1

# OSS Bucket 名称
OSS_BUCKET_AUDIOS=audios
OSS_BUCKET_CASE_RESULT=case-result
OSS_BUCKET_REF_PARAMS=ref-params
OSS_BUCKET_REPORTS=reports
OSS_BUCKET_ARCHIVES=archives
OSS_BUCKET_TEMP=temp

# 生产环境切换示例（取消注释即可）：
# OSS_ENDPOINT=https://s3.cn-north-1.amazonaws.com.cn
# OSS_ACCESS_KEY=your-aws-access-key
# OSS_SECRET_KEY=your-aws-secret-key
# OSS_REGION=cn-north-1

# 服务标识
SERVICE_NAME=dev
SERVICE_HOST=localhost

# FFmpeg
FFMPEG_PATH=
FFPROBE_PATH=

# 日志
LOG_LEVEL=DEBUG
CONSOLE_LOG_ENABLED=true
