# ========== 必填 ==========
DATABASE_URL=postgresql://intelligent_audio_test:intelligent_audio_test666@localhost:5432/intelligent_audio_test
OSS_ACCESS_KEY=intelligent_audio_test
OSS_SECRET_KEY=intelligent_audio_test666

# ========== 基础设施 ==========
REDIS_URL=redis://localhost:6379
OSS_ENDPOINT=http://localhost:9000
OSS_REGION=us-east-1
SERVICE_HOST=localhost
SERVICE_NAME=dev

# ========== OSS Bucket（单桶模式）==========
# 单桶模式：所有 category 共用此桶，key 统一拼成 {OSS_KEY_PREFIX}/{category}/{key}
OSS_BUCKET_NAME=intelligent-audio-test
OSS_KEY_PREFIX=intelligent_audio_test
# 以下多桶配置仅在 OSS_BUCKET_NAME 为空时生效（向后兼容）
OSS_BUCKET_AUDIOS=audios
OSS_BUCKET_CASE_RESULT=case-result
OSS_BUCKET_REF_PARAMS=ref-params
OSS_BUCKET_REPORTS=reports
OSS_BUCKET_ARCHIVES=archives
OSS_BUCKET_TEMP=temp
# 前端直传 OSS 分片临时存储（非 WAV 文件转码前中转），建议配置 OSS 生命周期 7 天 TTL
OSS_BUCKET_RAW_CHUNKS=raw-chunks

# ========== API Gateway ==========
# 本地静态资源根目录（含 test.wav 等固定测试音频）
# 未设 AUDIO_STORAGE_PATH 时，实际路径 = LOCAL_STORAGE_ROOT/audios
LOCAL_STORAGE_ROOT=D:\00_code\static
# 本地音频上传临时存储路径（分片上传/合并/转码中间文件），默认 = LOCAL_STORAGE_ROOT/audios
# AUDIO_STORAGE_PATH=./storage/audios

# ========== Task Service ==========
MAX_CONCURRENT=5
TASK_TIMEOUT=3600

# ========== E2E Test Service ==========
LAB_NAME=lab-a

# ========== 第三方评估中转（evaluation_service，INT-84）==========
# 区角色：self_zone == hub_zone 即评估中枢（B，单机默认）；self_zone != hub_zone
# 为边缘区（A），评估自动中转到中枢执行。全部键默认缺省即单机形态，无需配置。
# THIRD_PARTY_EVAL_SELF_ZONE=B              # 本区角色（默认 B）
# THIRD_PARTY_EVAL_HUB_ZONE=B               # 评估中枢区（默认 B）
# THIRD_PARTY_EVAL_SYNC_BACK_ZONE=A         # 结果回同步的边缘区（默认 A）
# 中枢侧中转执行触发器：默认 false（INT-84）。单机部署保持默认；
# 跨区部署（A→B 中转）需显式开启并配置区间预共享 token（见下），
# 区配置不完整（入站 token 缺失）时触发器自动不启动（仅启动时记一条 INFO）。
THIRD_PARTY_EVAL_RELAY_TRIGGER_ENABLED=false
# 跨区部署区间预共享 token（HMAC 签名路由密钥，边缘区 A↔中枢 B 一致才能通）：
# TRANSFER_TOKEN_A_B=<A↔B 区间共享密钥>
# TRANSFER_TOKEN_B_C=<B↔C 第三方执行区间共享密钥>
# 也可经 shared/config/secrets_config.json 配置（键名 TOKEN_A_B / TOKEN_B_C）。

# ========== 评估维度种子与兜底（INT-107）==========
# 维度种子脚本的评估端点默认值：scripts/migrations 下 seed_*.py 以
# EVAL_SERVER_URL 写入 dimensions.api_url，不设则默认 http://100.70.20.135:8888。
# 建议指向本环境可达的 eval_server，避免种子后整批维度外呼不可达端点。
#EVAL_SERVER_URL=http://127.0.0.1:8888
# 联调/验收/回归可指向 mock 替身（INT-182，MOCK_SERVICES_ENABLED=true 时随 run_all
# 启动；端口 = service_ports.MOCK_EVAL_SERVER_HTTP_PORT）：
#EVAL_SERVER_URL=http://127.0.0.1:5097
# 兜底评估端点列表（evaluation_service 运行时降级路径）：主端点连接级失败
# （不可达/连接超时）时依次切换重试；逗号分隔多个。留空 = 不降级（fail-closed）。
# 也可经 shared/config/concurrency_config.json 的 evaluation_service.eval_fallback_urls
# 配置（列表）；环境变量优先。
#EVAL_FALLBACK_URLS=http://127.0.0.1:18888


# ========== Mock 替身服务（INT-137/INT-182，仅联调/验收/回归用）==========
# MOCK_SERVICES_ENABLED=true 时 run_all.py 额外启动三个独立 mock 服务（默认 false，
# 生产路径零依赖：不进生产 docker-compose 编排与镜像，任何生产服务不 import mock）：
#   mock_third_party_eval  HTTP :5099  第三方评估 C 区替身（multipart / feature_extract /
#                                      presigned_url 三契约，EVAL_RESULT 回传，/health + /__control）
#   mock_realtime_api      WS  :5098  Realtime 被测产品替身（session.update 确认 / 逐帧 ack /
#                                      commit 响应流 / done 收口，延迟·断连·协议错误可注入）
#   mock_eval_server_judge HTTP :5097  eval_server 裁判端点替身（INT-182，异步任务协议
#                                      create_task/get_status/get_final_result，INT-95 R8
#                                      llm_judge 结果契约，延迟·5xx/4xx·协议错误·轮次形态可注入）
#MOCK_SERVICES_ENABLED=false
# mock 行为可经命令行参数 / MOCK_EVAL_* / MOCK_RT_* / MOCK_JUDGE_* 环境变量 /
# 配置文件配置，运行中可热更新：HTTP 控制端点（评估与裁判 mock）或
# __mock_control WS 控制帧（realtime mock）。
#
# 联调形态示例（transfer_agent 出站 → mock 评估 → EVAL_RESULT 回流全链）：
# ① transfer_agent 出站腿指向 mock 评估（B→C 数据面），需同时满足出站路由白名单：
#TRANSFER_ZONE=B
#TRANSFER_THIRD_PARTY_C_API_BASE_URL=http://127.0.0.1:5099
#TRANSFER_TOKEN_B_C=<B↔C 第三方执行区间共享密钥（与评估 ACL 侧一致）>
# ② 评估能力注册表 THIRD_PARTY_C 指向 mock：shared/config/evaluation_capability_config.json
#    将 llm_judge（multipart）/ mos（presigned_url）的 enabled 置 true 即可（dimension→target
#    路由在注册表，C 端地址在上方 TRANSFER_THIRD_PARTY_C_API_BASE_URL）。
# ③ evaluation_service 侧 THIRD_PARTY_EVAL_* 配置保持单机默认（self_zone=B）。
#
# 联调形态示例（evaluation_service 出站评估 → mock eval_server 裁判，INT-182）：
# 评估端点经种子脚本 EVAL_SERVER_URL 写入 dimensions.api_url（见上方 INT-107 段），
# 或运行时经 EVAL_FALLBACK_URLS 兜底；指向 http://127.0.0.1:5097 即接入裁判替身
# （Redis 回调 5s 超时后自动降级 HTTP 轮询，替身不推回调，链路多 ~5s 属预期）。

# ========== 端口注册红线（INT-37）==========
# 所有服务端口以 shared/config/service_ports.py 为唯一来源（HTTP 5000-5010、
# gRPC 50051-50101），各服务代码内 os.environ.get 的默认值即注册值，
# 本地起服不需要再设任何端口变量。
# 禁止书写不带服务前缀的 PORT= / GRPC_PORT=：dotenv 全局注入且后值覆盖前值，
# 单独启动的任意服务都会被污染成同一个端口（INT-37：auth gRPC 被打到 50051）。
# 确需覆写某服务端口时，用服务前缀变量（如 AUTH_SERVICE_GRPC_PORT），
# 且取值必须与 service_ports.py 一致；端口分配调整一律改 service_ports.py。
# 启动器无需覆盖端口：run_all.py / docker compose 按服务显式注入注册值。

# ========== gRPC 服务发现 ==========
E2E_TEST_SERVICE_HOST=localhost
E2E_TEST_SERVICE_GRPC_PORT=50051
TASK_SERVICE_HOST=localhost
TASK_SERVICE_GRPC_PORT=50061
API_TEST_SERVICE_HOST=localhost
API_TEST_SERVICE_PORT=5003
API_TEST_SERVICE_GRPC_PORT=50071
EVALUATION_SERVICE_HOST=localhost
EVALUATION_SERVICE_GRPC_PORT=50091
AUDIO_SERVICE_HOST=localhost
AUDIO_SERVICE_GRPC_PORT=50052
DEVICE_SERVICE_HOST=localhost
DEVICE_SERVICE_GRPC_PORT=50053
ADAPTER_SERVICE_HOST=localhost
ALGORITHM_SERVICE_HOST=localhost
ALGORITHM_SERVICE_GRPC_PORT=50067
REPORT_SERVICE_HOST=localhost
REPORT_SERVICE_GRPC_PORT=50068
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_GRPC_PORT=50069

# ========== 工具 ==========
# 默认走 PATH 中的 ffmpeg/ffprobe；如未安装可指定绝对路径
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ========== 日志 ==========
LOG_LEVEL=INFO
CONSOLE_LOG_ENABLED=true

# ========== 分布式协调 ==========
# 默认开启。自动启用 Redis 分布式锁/信号量/控制标志位，保障多实例并发安全。
# 单实例部署时 Redis 不可达会自动降级放行，不影响正常运行。
# 如确需关闭，设为 false。
DISTRIBUTED_COORDINATOR_ENABLED=true

# ========== 认证配置 ==========
# 认证模式: dev(本地OAuth) / prod(华为云OAuth) / off(无认证)
AUTH_MODE=off

# JWT 配置
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# 开发模式 - 本地 OAuth
DEV_OAUTH_CLIENT_ID=local_dev_client
DEV_OAUTH_CLIENT_SECRET=local_dev_secret
DEV_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
DEV_DEFAULT_USERNAME=dev_user
DEV_DEFAULT_PASSWORD=dev_password
DEV_DEFAULT_ROLE=admin

# 生产模式 - 华为云 OAuth
HW_OAUTH_CLIENT_ID=
HW_OAUTH_CLIENT_SECRET=
HW_OAUTH_REDIRECT_URI=http://your-domain/api/v1/auth/callback
HW_OAUTH_AUTHORIZE_URL=https://oauth.huaweicloud.com/oauth2/authorize
HW_OAUTH_TOKEN_URL=https://oauth.huaweicloud.com/oauth2/token
HW_OAUTH_USERINFO_URL=https://oauth.huaweicloud.com/oauth2/userinfo

# 登录密码 RSA 加密传输（INT-147 对齐旧库安全基线）
# false 时 /auth/login、/auth/register 接受明文 password 字段（灰度回退）
AUTH_PASSWORD_ENCRYPTION_ENABLED=true
# RSA 私钥 PEM 持久化路径（不存在时自动生成；务必与 data/ 一起备份）
# AUTH_RSA_KEY_PATH=D:\00_code\V9.7.31\Intelligent-Audio-TEST\data\auth_key.pem

# OAuth 绑定票据有效期（秒）：intent=bind 回调回前端票据的完成窗口
OAUTH_BIND_TICKET_TTL_SECONDS=300

# ========== API Adapter（语音 LLM / 火山引擎，api_adapter_service 用）==========
VOICE_LLM_API_BASE=
VOICE_LLM_API_KEY=
VOLC_WS_URL=
VOLC_API_KEY=

# ===== 邮件通知 SMTP（INT-80 设备告警通知渠道；SMTP_HOST 留空=禁用，告警仅落库）=====
