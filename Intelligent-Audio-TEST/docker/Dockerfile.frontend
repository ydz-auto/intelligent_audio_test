# 前端生产构建镜像 —— 构建 frontend-react（pnpm + rsbuild），nginx 托管 dist。
# 认证模式不进构建产物：前端启动后经 GET /auth/mode 取后端 AUTH_MODE（INT-180），
# 因此本文件不再接收 VITE_AUTH_MODE（旧 Vue 前端 frontend/ 已下线）。
# 用法（compose）：docker compose build frontend
# 用法（裸 docker）：docker build -f docker/Dockerfile.frontend ..

# ---- 构建阶段 ----
FROM node:20-alpine AS build
WORKDIR /app

# pnpm 版本与 frontend-react/pnpm-lock.yaml（lockfileVersion 9.0）配套，可按需覆盖
ARG PNPM_VERSION=10
RUN npm install -g "pnpm@${PNPM_VERSION}"

COPY frontend-react/package.json frontend-react/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend-react/ ./
RUN pnpm build

# ---- 运行阶段 ----
FROM nginx:alpine
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
