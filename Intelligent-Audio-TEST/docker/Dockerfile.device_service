FROM python:3.11-slim

WORKDIR /app

# 系统依赖：设备通信（adb、串口）、音频播放（ffmpeg、alsa）
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    adb \
    alsa-utils \
    libasound2 \
    libasound2-dev \
    pulseaudio \
    && rm -rf /var/lib/apt/lists/*

COPY Intelligent-Audio-TEST/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY Intelligent-Audio-TEST/ .

EXPOSE 50053

CMD ["python", "-m", "device_service.interfaces.grpc.server"]
