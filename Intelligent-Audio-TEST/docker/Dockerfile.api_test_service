# 依赖来自共用基座 iat-base（docker/Dockerfile.base + docker/requirements/base.txt），
# 本镜像只叠加服务代码层。构建入口：python docker/build_stack.py api_test_service
ARG BASE_IMAGE=iat-base:latest
FROM ${BASE_IMAGE}

# 本服务增量依赖（grpcio-tools 等，基座未含）
ARG PIP_INDEX_URL=https://pypi.org/simple
COPY docker/requirements/api_test_service.txt ./requirements-extra.txt
RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements-extra.txt

WORKDIR /app

COPY . .

EXPOSE 5003 50071
CMD ["python", "-m", "api_test_service.app"]
