# 容器化后端共用基座镜像（iat-base）
#
# 目的：把 10 个后端服务共用的 Python 依赖收敛成一镜像层，服务镜像只叠加自己的代码层，
# 依赖层在磁盘/节点上只存一份（原方案每个服务各存一份 1.7–2.7GB）。
#
# 构建：python docker/build_stack.py 会先构建本基座（tag: iat-base:latest）再构建各服务；
# 单独构建：docker build -f docker/Dockerfile.base -t iat-base:latest .
# 依赖清单：docker/requirements/base.txt（与根 requirements.txt 的差异及原因见该文件注释）。
ARG PY_IMAGE=python:3.11-slim
# INT-2166：apt / pip 走可达镜像源（统一约定见 docker/README.md §3）
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG PIP_INDEX_URL=https://pypi.org/simple
FROM ${PY_IMAGE}

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUTF8=1 \
    PYTHONPATH=/app:/app/shared/proto

# 阶段内重声明（FROM 前的 ARG 在 FROM 后不再在作用域内）
ARG APT_MIRROR
ARG PIP_INDEX_URL

COPY docker/requirements/base.txt ./requirements.txt

# gcc/libc6-dev/libffi-dev 仅少数 wheel 源码编译期需要；pip 装完即同层 purge，
# 避免把编译工具链带进最终基座。
RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|${APT_MIRROR}|g" "$f"; \
    done; \
    apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        gcc libc6-dev libffi-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements.txt \
    && apt-get purge -y --auto-remove gcc libc6-dev libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# 基座不含 ffmpeg / adb / 声卡库：容器内后端不做音频解码与设备直连（仅宿主侧
# audio_service / device_service 使用）。若某服务确需，请在该服务 Dockerfile 单独加 apt 层。
