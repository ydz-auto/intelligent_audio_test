# INT-1176：隔离栈被测 API DUT 替身专用镜像。
# mock_dut_api 为纯标准库 + mock_services / shared.config.service_ports
# （服务端口注册常量），无第三方依赖——不随 2.19GB 后端业务镜像
# 走，隔离栈可秒级起替身。生产路径零引用；仅 docker/docker-compose.iso.yml 的隔离栈引用。
FROM python:3.11-slim
WORKDIR /app
COPY mock_services/ ./mock_services/
COPY shared/__init__.py ./shared/__init__.py
COPY shared/config/ ./shared/config/
ENV PYTHONPATH=/app
EXPOSE 5096
CMD ["python", "mock_services/mock_dut_api.py", "--port", "5096"]
