FROM python:3.11-slim

# INT-2166：apt / pip 走可达镜像源（统一约定见 docker/README.md §3）。
# 缺省值即推荐值；compose 经 x-backend-build-args 透传，可 --build-arg 或 .env 覆盖。
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG PIP_INDEX_URL=https://pypi.org/simple

WORKDIR /app

# 系统依赖：音频播放（ffmpeg、alsa、pulseaudio）、设备通信（adb、串口）
RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|${APT_MIRROR}|g" "$f"; \
    done; \
    apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ffmpeg \
    adb \
    alsa-utils \
    libasound2 \
    libasound2-dev \
    pulseaudio \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt
RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|${APT_MIRROR}|g" "$f"; \
    done; \
    apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        gcc libc6-dev libffi-dev portaudio19-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements.txt

COPY . .

EXPOSE 5002 50051

CMD ["python", "-m", "e2e_test_service.app"]
