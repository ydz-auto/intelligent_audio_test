# 数据面 audio_service（AUDIO_ROLE=server）：音频库 CRUD/元数据/标签预热。
# 硬件面（真声卡播放/试听/SPL）不在这里，见执行机宿主 audio_agent
# （docs/audio服务拆分方案.md §6）。构建入口：python docker/build_stack.py audio_service
ARG BASE_IMAGE=iat-base:latest
FROM ${BASE_IMAGE}

WORKDIR /app

COPY . .

EXPOSE 50052
CMD ["python", "-m", "audio_service.interfaces.grpc.server"]
