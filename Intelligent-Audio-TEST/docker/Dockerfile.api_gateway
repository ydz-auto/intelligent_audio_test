# 依赖来自共用基座 iat-base（docker/Dockerfile.base + docker/requirements/base.txt），
# 本镜像只叠加网关代码层。构建入口：python docker/build_stack.py api_gateway
#
# 原 ffmpeg + adb 系统层已移除：容器内无 ffmpeg/adb 调用（仅宿主侧 audio_service /
# device_service 使用），该层曾占 465MB 且每个网关镜像各存一份。
ARG BASE_IMAGE=iat-base:latest
FROM ${BASE_IMAGE}

WORKDIR /app

COPY . .

EXPOSE 5000
CMD ["python", "-m", "api_gateway.app"]
