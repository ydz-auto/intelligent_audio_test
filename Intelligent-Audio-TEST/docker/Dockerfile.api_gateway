# 依赖来自共用基座 iat-base（docker/Dockerfile.base + docker/requirements/base.txt），
# 本镜像只叠加网关代码层。构建入口：python docker/build_stack.py api_gateway
#
# 不装 ffmpeg：网关内唯一的 pydub 用法是
# api_gateway/application/services/audio/audio_common.py#convert_to_wav，
# 全仓检索确认无任何调用方（音频转码实际由服务器 audio_service / 执行机 audio_agent 完成），
# 因此无需把 400MB+ 的 ffmpeg 层带进网关镜像；若将来启用该函数需在本文件补 apt 层。
ARG BASE_IMAGE=iat-base:latest
FROM ${BASE_IMAGE}

WORKDIR /app

COPY . .

EXPOSE 5000
CMD ["python", "-m", "api_gateway.app"]
