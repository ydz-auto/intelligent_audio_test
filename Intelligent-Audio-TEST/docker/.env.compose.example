# INT-272：Docker Compose 形态环境变量样例（docker/run_stack.py 与 compose 共用）
#
# 用法：复制为仓库根 .env.compose（或并入现有 .env），`python docker/run_stack.py up`
# 会读取仓库根 .env 并透传给 compose。带 * 的变量必填（缺失时 compose 报错退出）。
#
# 数据库 / Redis / OSS 的容器内地址由 docker-compose.yml 内置（服务名寻址），
# 宿主 .env 中指向 localhost 的 DATABASE_URL/REDIS_URL/OSS_ENDPOINT 不会覆盖容器形态。

# ==================== 必填 ====================

# 认证模式（off|dev|prod），两个变量必须一致（INT-180/181 前后端同源）
# AUTH_MODE=dev
# VITE_AUTH_MODE=dev

# ---- 本端稳定服务标识（离线搬运 source_map；INT-1862 / 设计文档 §5.3、§8）----
# A/B 两侧必须各自不同（A 用 server-A、B 用 server-B 之类），换机 / 换容器都不能变。
# 留空 = 回落 `SERVICE_NAME-<容器 hostname>`（如 task_service-b2206018024e），容器每次
# 重建即变 → 历史 source_map 匹配不上，链路 2 增量回导断链。
# 导出写 manifest.serverInfo.source，导入侧读它作 source_map.source_server。
DATA_TRANSFER_SERVER_ID=server-A

# ==================== 可选（缺省值如下）====================

# ---- infra 凭据（与历史口径一致）----
# POSTGRES_USER=intelligent_audio_test
# POSTGRES_PASSWORD=intelligent_audio_test666
# POSTGRES_DB=intelligent_audio_test
# OSS_ACCESS_KEY=intelligent_audio_test
# OSS_SECRET_KEY=intelligent_audio_test666

# ---- 预签名 URL 的对外地址（INT-1719）----
# 容器内 OSS_ENDPOINT 是 compose 服务名（rustfs:9000），把它签进 URL 交给宿主浏览器
# 会 net::ERR_NAME_NOT_RESOLVED（用例预览「音频播放失败」）。本变量是「返回给浏览器/
# 第三方」的地址，compose 里 api_gateway / task_service / report_service /
# api_test_service 用它签名，内部读写仍走 OSS_ENDPOINT。
# 缺省（不设或空串）= 回落 OSS_ENDPOINT，宿主/单机部署行为不变。跨机访问改成局域网
# IP 或公开域名，不要写死 127.0.0.1。
# OSS_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# ---- JWT（生产环境必须更换）----
# JWT_SECRET=dev-secret-change-in-production
# JWT_EXPIRE_HOURS=24
# JWT_ALGORITHM=HS256

# ---- db_bootstrap 引导用户种子（INT-156 口径；空库时种子该用户）----
# DEV_DEFAULT_USERNAME=dev_user
# DEV_DEFAULT_ROLE=admin
# DEV_DEFAULT_PASSWORD=dev_password

# ---- 端口覆盖（切换窗口期与宿主旧栈并存验证用；下游口径缺省即现状）----
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# RUSTFS_PORT=9000
# RUSTFS_CONSOLE_PORT=9001
# FRONTEND_PORT=5173
# API_GATEWAY_PORT=5000
# TASK_SERVICE_HTTP_PORT=5001
# E2E_TEST_HTTP_PORT=5002
# EVALUATION_SERVICE_HTTP_PORT=5004
# REPORT_SERVICE_HTTP_PORT=5006
# ALGORITHM_SERVICE_HTTP_PORT=5007
# AUTH_SERVICE_HTTP_PORT=5009
# TRANSFER_AGENT_HTTP_PORT=5010
# E2E_TEST_GRPC_PORT=50051
# AUDIO_SERVICE_GRPC_PORT=50052
# DEVICE_SERVICE_GRPC_PORT=50053
# TASK_SERVICE_GRPC_PORT=51061
# ALGORITHM_SERVICE_GRPC_PORT=51067
# REPORT_SERVICE_GRPC_PORT=51068
# AUTH_SERVICE_GRPC_PORT=51069
# API_TEST_SERVICE_GRPC_PORT=51071
# EVALUATION_SERVICE_GRPC_PORT=51091
# TRANSFER_AGENT_GRPC_PORT=51101

# ---- api_test_service 多副本数（UC-1001；宿主不发布端口）----
# API_TEST_REPLICAS=2

# ---- 跨区传输（transfer_agent，B 区实例才需要）----
# TRANSFER_ZONE=A

# ---- 镜像/网络加速（内网/镜像源环境按需覆盖）----
# PY_IMAGE=python:3.11-slim
# NODE_IMAGE=node:20-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# REDIS_IMAGE=redis:7-alpine
# RUSTFS_IMAGE=rustfs/rustfs:latest
# PIP_INDEX_URL=https://pypi.org/simple
