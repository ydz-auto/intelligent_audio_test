FROM python:3.11-slim

# INT-2456：agent_service 镜像（Agent 运行底座，方案 07 §12.1）。
# 与其余后端镜像同一构建约定（docker/README.md §3）：APT_MIRROR / PIP_INDEX_URL
# 经 compose 的 x-backend-build-args 透传，缺省值即推荐值。
#
# 运行期只读/写卷（由 docker-compose.yml 挂载，镜像内不固化）：
#   /app/skills                 只读（Skill 单一事实源，顶层目录）
#   /app/memory                 可写（长期记忆，按 tenant/owner 隔离的文件树）
#   /app/agent_service/config   只读（model_catalog.json / agent_defaults.json）
# 三者任一缺失时服务启动即失败（agent_service/config/config.py:validate_mounts），
# 不静默降级成空目录。
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG PIP_INDEX_URL=https://pypi.org/simple

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|${APT_MIRROR}|g" "$f"; \
    done; \
    apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        gcc libc6-dev libffi-dev portaudio19-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements.txt

COPY . .

# 宿主/编排可覆盖；与 shared/config/service_ports.py:AGENT_SERVICE_HTTP_PORT 同值。
ENV PORT=5011
EXPOSE 5011

# 不持有 docker.sock（方案 07 §7）：沙箱执行只经独立 runner/sidecar（HTTP）。
CMD ["python", "-m", "agent_service.app"]
