FROM python:3.11-slim

WORKDIR /app

# 系统依赖：报告生成（libffi）、音频处理（ffmpeg）
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Intelligent-Audio-TEST/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY Intelligent-Audio-TEST/ .

EXPOSE 5004 50091

CMD ["python", "-m", "evaluation_service.app"]
