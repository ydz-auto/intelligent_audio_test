# 生产环境配置
# Vite 代理目标 — 生产部署时由 nginx/网关处理，此处仅占位
VITE_API_TARGET=http://localhost:6000

# 认证模式：生产构建必须显式注入 VITE_AUTH_MODE（INT-181），禁止在此写死默认值。
# 取值：off（关闭认证，向后兼容）| dev（本地 OAuth）| prod（华为云 OAuth），须与后端 Config.AUTH_MODE 一致。
# 注入方式：VITE_AUTH_MODE=prod npm run build，或 docker build --build-arg VITE_AUTH_MODE=prod。
# 未注入时构建显式失败（见 vite.config.ts 构建期守卫），取值含义见 docs/oauth.md。

# INT-100：日志实时轮询节流（可选随批）——基础轮询间隔与空闲退避上限（毫秒）
# 空闲任务连续轮询无新日志时间隔按 2 的幂退避至上限，新数据/条件变化恢复基础间隔
# VITE_LOG_POLL_INTERVAL_MS=5000
# VITE_LOG_POLL_IDLE_MAX_MS=30000
