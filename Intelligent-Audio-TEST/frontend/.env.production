# 生产环境配置
# Vite 代理目标 — 生产部署时由 nginx/网关处理，此处仅占位
VITE_API_TARGET=http://localhost:6000

# 认证模式：生产环境按需开启（dev / prod）
# 部署时按实际后端 Config.AUTH_MODE 修改
VITE_AUTH_MODE=off

# INT-100：日志实时轮询节流（可选随批）——基础轮询间隔与空闲退避上限（毫秒）
# 空闲任务连续轮询无新日志时间隔按 2 的幂退避至上限，新数据/条件变化恢复基础间隔
# VITE_LOG_POLL_INTERVAL_MS=5000
# VITE_LOG_POLL_IDLE_MAX_MS=30000
