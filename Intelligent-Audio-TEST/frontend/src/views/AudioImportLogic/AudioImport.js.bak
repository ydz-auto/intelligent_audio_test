const showUploadModal = ref(false);
const showUrlImportModal = ref(false);
const showConvertModal = ref(false);
const showMetadataModal = ref(false);
const showFolderImportModal = ref(false);

function initModalWatchers() {
  const store = useModalStore();
  watch(() => store.showUploadModal, (val) => { showUploadModal.value = val; }, { immediate: true });
  watch(() => store.showUrlImportModal, (val) => { showUrlImportModal.value = val; }, { immediate: true });
  watch(() => store.showConvertModal, (val) => { showConvertModal.value = val; }, { immediate: true });
  watch(() => store.showMetadataModal, (val) => { showMetadataModal.value = val; }, { immediate: true });
  
  // 监听全局上传模态框的配置变化
  const manager = getModalManager();
  watch(() => manager.activeModals[MODAL_TYPES.UPLOAD_FILE]?.props?.uploadConfig, (config) => {
    if (config) {
      uploadOptions.value.createTestCase = config.createTestCase || false;
      uploadOptions.value.testType = config.testType || 'api';
      uploadOptions.value.playbackDeviceId = config.playbackDeviceId || null;
      uploadOptions.value.defaultSpl = config.defaultSpl || 65.0;
    }
  }, { deep: true });
}

