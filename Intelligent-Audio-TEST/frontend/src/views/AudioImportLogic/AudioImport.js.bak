// 预览音频
async function previewAudio(audioId, device = null) {
  console.log(`AudioImport: 预览音频 - ID: ${audioId}`);
  
  // 如果提供了设备参数，直接使用该设备播放音频
  if (device) {
    await playAudioWithDevice(audioId, device);
    return;
  }
  
  // 获取当前音频信息
  const audio = audios.value.find(a => a.id === audioId);
  if (!audio) {
    console.error(`AudioImport: 未找到ID为 ${audioId} 的音频`);
    return;
  }
  
  // 设置预览音频相关变量
  currentPreviewAudioId = audioId;
  currentPreviewAudioType = audio?.audioType || audio?.type || 'dry';
  audioTitle.value = audio.filename || audio.name || '未知音频';
  
  // 直接打开音频播放器模态窗，不需要选择设备
  showAudioPlayerModal.value = true;
}

// 使用指定设备播放音频的函数
async function playAudioWithDevice(audioId, device) {
  // 创建Audio对象用于播放音频
  const audio = new Audio();
  
  // 标记是否已经显示过错误弹窗，防止重复显示
  let errorShown = false;
  
  // 添加错误事件监听器，处理音频文件不存在等情况
  audio.addEventListener('error', (event) => {
    if (errorShown) return;
    
    let errorMessage = '音频播放失败';
    switch (audio.error.code) {
      case MediaError.MEDIA_ERR_ABORTED:
        errorMessage = '音频播放被中止';
        break;
      case MediaError.MEDIA_ERR_NETWORK:
        errorMessage = '网络错误导致音频无法加载';
        break;
      case MediaError.MEDIA_ERR_DECODE:
        errorMessage = '音频解码失败';
        break;
      case MediaError.MEDIA_ERR_SRC_NOT_SUPPORTED:
        errorMessage = '音频源不支持或不存在';
        break;
      default:
        errorMessage = '音频播放失败，未知错误';
    }
    console.error('音频播放错误:', event, audio.error);
    alert(errorMessage);
    errorShown = true;
  });
  
  // 如果选择的是外部设备，调用后端API播放
  if (device.id.startsWith('external_')) {
    const externalDeviceId = device.id.replace('external_', '');
    try {
      // 调用后端API播放音频到外部设备
      const { audiosApi } = await import('../../utils/api');
      await audiosApi.preview(audioId, { playback_device_ids: [externalDeviceId] });
      console.log(`开始从外部设备 ${externalDeviceId} 播放音频 ${audioId}`);
      // 使用console.log代替alert，避免阻塞后续设备的播放
      console.log(`已开始从外部设备 ${playbackDevices.value.find(d => d.id === externalDeviceId)?.name} 播放音频`);
    } catch (err) {
      console.error('外部设备播放失败:', err);
      // 使用console.error代替alert，避免阻塞后续设备的播放
      console.error('外部设备播放失败: ' + err.message);
    }
    return;
  }
  
  // 设置音频源为后端提供的预览URL
  audio.src = `/api/v1/audios/${audioId}/stream`;
  
  // 设置音频输出设备
  if (audio.setSinkId) {
    // 只有当device.id不是外部设备且不是'default'时，才尝试设置sinkId
    // 外部设备和default设备不需要调用setSinkId
    if (!device.id.startsWith('external_') && device.id !== 'default') {
      try {
        await audio.setSinkId(device.id);
      } catch (err) {
        console.error('设置音频输出设备失败:', err);
        // 只在控制台输出错误，不显示alert，避免影响用户体验
        // 使用console.warn而不是console.error，因为这不是严重错误
        console.warn('音频将使用默认设备播放');
      }
    }
  }
  
  // 播放音频
  audio.play().catch(error => {
    if (errorShown) return;
  
    console.error('音频播放失败:', error);
    // 根据不同的错误类型显示更友好的提示
    let errorMessage = '音频播放失败';
    if (error.name === 'NotAllowedError') {
      errorMessage = '播放音频被浏览器阻止，请检查浏览器音频设置';
    } else if (error.name === 'NotSupportedError') {
      errorMessage = '浏览器不支持该音频格式';
    } else if (error.name === 'AbortError') {
      errorMessage = '音频播放被中止';
    } else if (error.name === 'NotFoundError') {
      errorMessage = '音频文件不存在';
    }
    alert(errorMessage);
    errorShown = true;
  });
  
}

// 编辑元数据
function editMetadata(audioId) {
  console.log(`AudioImport: 编辑元数据 - ID: ${audioId}`);
  const audio = audios.value.find(a => a.id === audioId);
  if (audio) {
    // 处理不同格式的标签数据
    let tagsArray = [];
    if (Array.isArray(audio.tags)) {
      tagsArray = audio.tags;
    } else if (Array.isArray(audio.tag)) {
      tagsArray = audio.tag;
    } else if (typeof audio.tags === 'string' && audio.tags) {
      tagsArray = audio.tags.split(',').map(tag => tag.trim());
    } else if (typeof audio.tag === 'string' && audio.tag) {
      tagsArray = audio.tag.split(',').map(tag => tag.trim());
    }
    
    // 构建元数据信息
    const metadata = {
      id: audio.id,
      fileName: audio.name || audio.filename || '',
      category: audio.path || '',
      audioType: audio.audio_type || audio.type || 'dry',
      asrText: audio.asr_text || audio.asrText || '',
      translations: audio.translations || [{ direction: 'zh-en', text: '' }],
      tags: tagsArray.join(',')
    };
    
    // 使用全局模态窗显示音频详情
    const manager = getModalManager();
    manager.openModal(MODAL_TYPES.DETAIL_VIEW, {
      title: '音频详情',
      data: metadata,
      fields: [
        { key: 'fileName', label: '文件名', className: '' },
        { key: 'category', label: '分类', className: '' },
        { key: 'audioType', label: '音频类型', className: '' },
        { key: 'asrText', label: 'ASR文本', className: '' },
        { key: 'tags', label: '标签', className: '' },
        { key: 'translations', label: '翻译语向', className: '' }
      ],
      onSave: async (editedData) => {
        console.log('AudioImport: 保存编辑的元数据', editedData);
        try {
          await audiosApi.updateMetadata(editedData.id, editedData);
          alert('元数据保存成功');
          fetchAudios();
        } catch (err) {
          alert('保存失败: ' + err.message);
        }
      }
    });
  }
}

// 添加翻译语向
function addTranslationItem() {
  console.log('AudioImport: 添加翻译语向');
  metadataInfo.value.translations.push({
    direction: 'zh-en',
    text: ''
  });
}

// 删除翻译语向
function removeTranslationItem(index) {
  console.log(`AudioImport: 删除翻译语向 - 索引 ${index}`);
  if (metadataInfo.value.translations.length > 1) {
    metadataInfo.value.translations.splice(index, 1);
  }
}

// 保存元数据
async function saveMetadata() {
  console.log('AudioImport: 保存元数据');
  try {
    const id = metadataInfo.value.id;
    if (id) {
      await audiosApi.updateMetadata(id, metadataInfo.value);
      alert('元数据保存成功');
      fetchAudios();
    }
    closeModal('metadataModal');
  } catch (err) {
    alert('保存失败: ' + err.message);
  }
}

