}

// 全选/取消全选
function toggleSelectAll(event) {
  console.log(`AudioImport: 全选/取消全选 - ${event.target.checked ? '全选' : '取消全选'}`);
  if (event.target.checked) {
    // 显示全选选项菜单
    showSelectAllOptions.value = true;
  } else {
    selectedAudios.value = [];
    showSelectAllOptions.value = false;
  }
}

// 仅勾选当前页
function selectCurrentPage() {
  console.log('AudioImport: 仅勾选当前页');
  selectedAudios.value = filteredAudios.value.map(audio => audio.id);
  showSelectAllOptions.value = false;
  // 确保全选复选框状态正确
  const selectAllCheckbox = document.getElementById('selectAll');
  if (selectAllCheckbox) {
    selectAllCheckbox.checked = filteredAudios.value.length > 0 && selectedAudios.value.length === filteredAudios.value.length;
  }
}

// 勾选所有页
async function selectAllPages() {
  console.log('AudioImport: 勾选所有页');
  // 关闭选项菜单
  showSelectAllOptions.value = false;
  
  // 立即更新全选复选框状态，提高用户体验
  const selectAllCheckbox = document.getElementById('selectAll');
  if (selectAllCheckbox) {
    selectAllCheckbox.checked = true;
  }
  
  // 1. 立即更新当前页的选中状态，让用户先看到当前页的复选框联动
  const currentPageIds = filteredAudios.value.map(audio => audio.id);
  selectedAudios.value = [...currentPageIds];
  
  // 2. 异步获取所有页的数据，不阻塞UI
  const fetchAllPages = async () => {
    // 显示加载提示
    const originalLoading = loading.value;
    loading.value = true;
    
    try {
      // 使用更高效的方式获取所有音频ID，而不是获取完整音频数据
      // 构建请求参数，保持当前筛选条件
      const fetchParams = {
        perPage: 1000, // 每次请求1000条，减少请求次数
        keyword: searchQuery.value,
        format: filters.value.format !== 'all' ? filters.value.format : '',
        sampleRate: filters.value.sampleRate !== 'all' ? filters.value.sampleRate : '',
        duration: filters.value.duration !== 'all' ? filters.value.duration : '',
        audioType: filters.value.audioType !== 'all' ? filters.value.audioType : ''
      };
      
      // 首先获取总条数和第一页数据
      const firstPageData = await audiosApi.getAll(fetchParams);
      const totalCount = firstPageData.total || 0;
      
      if (totalCount === 0) {
        selectedAudios.value = [];
        loading.value = originalLoading;
        return;
      }
      
      // 直接从后端获取所有ID，避免获取完整音频数据
      // 如果后端不支持批量获取ID，则使用当前页的ID类型来处理
      const idType = firstPageData.items.length > 0 ? typeof firstPageData.items[0].id : 'number';
      
      // 优化：如果数据量较小，直接获取所有数据
      if (totalCount <= 1000) {
        fetchParams.perPage = totalCount;
        const allData = await audiosApi.getAll(fetchParams);
        const allIds = allData.items.map(audio => {
          if (idType === 'number') {
            return Number(audio.id);
          }
          return audio.id;
        });
        // 异步更新所有ID，确保UI响应
        selectedAudios.value = allIds;
      } else {
        // 数据量大时，分批获取ID，每批1000条
        const allIds = [];
        let currentFetchPage = 1;
        let remainingCount = totalCount;
        
        while (remainingCount > 0) {
          fetchParams.page = currentFetchPage;
          const pageData = await audiosApi.getAll(fetchParams);
          
          if (pageData.items && pageData.items.length > 0) {
            // 只提取ID，不处理其他数据
            const pageIds = pageData.items.map(audio => {
              if (idType === 'number') {
                return Number(audio.id);
              }
              return audio.id;
            });
            allIds.push(...pageIds);
            remainingCount -= pageData.items.length;
            currentFetchPage++;
            
            // 每获取1000条就更新一次UI，让用户看到进度
            if (allIds.length % 1000 === 0) {
              selectedAudios.value = [...allIds];
            }
          } else {
            remainingCount = 0;
          }
        }
        
        // 最后更新完整的ID列表
        selectedAudios.value = allIds;
      }
      
    } catch (err) {
      console.error('获取所有音频失败:', err);
      alert('获取所有音频失败，请重试');
      // 出错时重置全选状态
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
      }
      selectedAudios.value = [];
    } finally {
      loading.value = originalLoading;
    }
  };
  
  // 启动异步获取
  fetchAllPages();
}

// 切换单个音频选择状态
function toggleAudioSelection(audioId) {
  const index = selectedAudios.value.indexOf(audioId);
  if (index === -1) {
    selectedAudios.value.push(audioId);
  } else {
    selectedAudios.value.splice(index, 1);
    // 如果取消选择了某个音频，全选复选框应该变为未勾选状态
    const selectAllCheckbox = document.getElementById('selectAll');
    if (selectAllCheckbox) {
      selectAllCheckbox.checked = false;
    }
  }
}

// 打开上传模态框
async function openUploadModal() {
  console.log('[GlobalModal] AudioImport: 打开上传音频文件模态框');
  
  // 确保翻译方向数据已加载
  await fetchTranslationDirections();
  
  const manager = getModalManager();
  
  // 构造测试用例生成选项
  const testCaseOptions = [];
  
  // 音频类型选项
  testCaseOptions.push({
    key: 'audioType',
    type: 'select',
    label: '音频类型',
    options: [
      { value: 'dry', label: '干声 (信号音频)' },
      { value: 'noise', label: '噪声' },
      { value: 'prompt', label: '提示词音频' }
    ],
    defaultValue: 'dry'
  });
  
  // 提取唯一的源语言列表（过滤掉undefined值）
  const uniqueSourceLanguages = [...new Set(translationDirections.value.map(dir => dir.source_language).filter(lang => lang !== undefined))];
  
  // 源语言选项
  testCaseOptions.push({
    key: 'sourceLanguage',
    type: 'select',
    label: '音频源语言',
    options: [
      { value: '', label: '请选择源语言' },
      ...uniqueSourceLanguages.map(lang => ({ 
        value: lang, 
        label: lang.toUpperCase() 
      }))
    ],
    defaultValue: ''
  });
  
  // 翻译方向选项（当生成测试用例时显示，过滤掉无效的翻译方向）
  testCaseOptions.push({
    key: 'translationDirectionId',
    type: 'select',
    label: '翻译方向',
    options: [
      { value: '', label: '请选择翻译方向' },
      ...translationDirections.value.filter(dir => 
        dir.id && dir.source_language && dir.target_language
      ).map(dir => ({
        value: dir.id,
        label: `${dir.source_language} → ${dir.target_language}${dir.description ? ` (${dir.description})` : ''}`
      }))
    ],
    defaultValue: ''
  });
  
  // 生成测试用例选项 - 始终传递所有选项，由UploadFileModal根据状态决定显示
  testCaseOptions.push({
    key: 'createTestCase',
    type: 'boolean',
    label: '为每个音频生成对应的测试用例',
    defaultValue: uploadOptions.value.createTestCase
  });
  
  // 测试类型选项
  testCaseOptions.push({
    key: 'testType',
    type: 'radio',
    label: '测试类型',
    options: [
      { value: 'api', label: 'API 测试' },
      { value: 'e2e', label: '端到端测试 (E2E)' }
    ],
    defaultValue: uploadOptions.value.testType || 'api'
  });
  
  // 播放设备选项（仅E2E）
  if (playbackDevices.value.length > 0) {
    testCaseOptions.push({
      key: 'playbackDeviceId',
      type: 'select',
      label: '播放设备',
      options: [
        { value: '', label: '请选择播放设备' },
        ...playbackDevices.value.map(d => ({ value: d.id, label: d.name }))
      ],
      defaultValue: uploadOptions.value.playbackDeviceId || ''
    });
  }
  
  // SPL选项
  testCaseOptions.push({
    key: 'defaultSpl',
    type: 'number',
    label: '声压级 (SPL)',
    defaultValue: uploadOptions.value.spl || 65,
    min: 0,
    max: 140,
    hint: '单位: dB SPL，默认值 65'
  });
  
  // 用例分组
  testCaseOptions.push({
    key: 'groupNameType',
    type: 'radio',
    label: '用例分组',
    options: [
      { value: 'root', label: '根目录名' },
      { value: 'custom', label: '自定义' }
    ],
    defaultValue: uploadOptions.value.groupNameType || 'root'
  });
  
  // 自定义分组名称
  testCaseOptions.push({
    key: 'customGroupName',
    type: 'text',
    label: '自定义分组名称',
    defaultValue: uploadOptions.value.customGroupName || '',
    placeholder: '请输入分组名称',
    hint: '当选择"自定义"时使用'
  });
  
  manager.openModal(MODAL_TYPES.UPLOAD_FILE, {
    title: '上传音频文件',
    supportedFormats: ['mp3', 'wav', 'flac', 'aac', 'm4a'],
    acceptedFileTypes: '.mp3,.wav,.flac,.aac,.m4a',
    maxFileSize: 100 * 1024 * 1024, // 100MB
    multiple: false,
    uploadOptions: testCaseOptions,
    onSubmit: async (data) => {
      console.log('[GlobalModal] AudioImport: 处理上传模态框确认事件', data);
      
      // 更新上传选项
      uploadOptions.value.createTestCase = data.createTestCase || false;
      uploadOptions.value.testType = data.testType || 'api';
      uploadOptions.value.playbackDeviceId = data.playbackDeviceId || null;
      uploadOptions.value.spl = data.defaultSpl || 65.0;
      uploadOptions.value.groupNameType = data.groupNameType || 'root';
      uploadOptions.value.customGroupName = data.customGroupName || '';
      uploadOptions.value.audioType = data.audioType || 'dry';
      uploadOptions.value.sourceLanguage = data.sourceLanguage || '';
      
      // 设置选中的文件
      selectedFilesForUpload.value = data.files || [];
      
      // 保存进度更新回调
      const onProgressUpdate = data.onProgressUpdate;
      const onUploadComplete = data.onUploadComplete;
      const onUploadError = data.onUploadError;
      const onCancelUpload = data.onCancelUpload;
      
      try {
        // 开始分块上传
        await startUpload(onProgressUpdate, onUploadComplete, onUploadError, onCancelUpload);
      } catch (err) {
        console.error('上传失败:', err);
        if (onUploadError) {
          onUploadError(err);
        }
      }
    },
    onCancel: () => {
      console.log('[GlobalModal] AudioImport: 处理上传模态框取消事件');
      // 取消正在进行的上传任务
      pauseUploadTask();
    },
    // 处理翻译方向变化事件，自动设置源语言
    onTranslationDirectionChanged: (directionId) => {
      console.log('[GlobalModal] AudioImport: 翻译方向变化', directionId);
      // 查找对应的翻译方向
      const direction = translationDirections.value.find(dir => dir.id === directionId);
      if (direction && direction.source_language) {
        // 更新上传选项中的源语言
        uploadOptions.value.sourceLanguage = direction.source_language;
      }
    }
  });
}





