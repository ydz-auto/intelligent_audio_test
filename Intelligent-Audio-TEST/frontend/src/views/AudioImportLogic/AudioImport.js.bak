// Purpose: Controller for the Audio Import View, handling audio fetching, upload, and batch folder import.
// MVC Role: Front-end Controller

import { ref, computed, watch, onMounted } from 'vue';
import { audiosApi } from '../../utils/api';
import { STATIC_CONFIG } from '../../utils/config';
import { MODAL_TYPES, getModalManager } from '../../composables/useModal';
import { useModalStore } from '../../stores/modalStore';
// 只导入主样式文件，所有组件样式已包含在main.css中
import '../../assets/styles/main.css';

// modalStore将在initModalWatchers函数中初始化

// 删除结果模态框相关状态和方法
const showDeleteResultModal = ref(false);
const deleteResult = ref({
  success: false,
  message: '',
  count: 0
});
const closeDeleteResultModal = () => {
  showDeleteResultModal.value = false;
};

// 生成唯一UUID作为任务ID
function generateTaskId() {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
    const r = Math.random() * 16 | 0;
    const v = c === 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
}

// 获取本地存储中的任务
function getLocalTasks() {
  try {
    const tasks = localStorage.getItem('audioUploadTasks');
    return tasks ? JSON.parse(tasks) : [];
  } catch (error) {
    console.error('获取本地任务失败:', error);
    return [];
  }
}

// 保存任务到本地存储
function saveLocalTask(task) {
  try {
    const tasks = getLocalTasks();
    const index = tasks.findIndex(t => t.taskId === task.taskId);
    if (index !== -1) {
      tasks[index] = task;
    } else {
      tasks.push(task);
    }
    localStorage.setItem('audioUploadTasks', JSON.stringify(tasks));
  } catch (error) {
    console.error('保存任务到本地失败:', error);
  }
}



// 计算文件MD5值
async function calculateFileMD5(file, progressCallback) {
  // 使用SparkMD5计算文件MD5
  const sparkMD5Module = await import('spark-md5');
  const sparkMD5 = sparkMD5Module.default || sparkMD5Module;
  
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    const hash = new sparkMD5.ArrayBuffer();
    const chunkSize = 1024 * 1024; // 1MB per chunk
    let position = 0;
    
    function processChunk() {
      const chunk = file.slice(position, position + chunkSize);
      reader.readAsArrayBuffer(chunk);
    }
    
    reader.onload = function(e) {
      hash.append(e.target.result);
      position += chunkSize;
      
      // 计算并报告进度
      if (progressCallback) {
        const progress = Math.min(1, position / file.size);
        progressCallback(progress);
      }
      
      if (position < file.size) {
        processChunk();
      } else {
        resolve(hash.end());
      }
    };
    
    reader.onerror = reject;
    processChunk();
  });
}



// 分片上传实现
async function startChunkUpload(onProgressUpdate, onUploadComplete, onUploadError, onCancelUpload) {
  if (selectedFilesForUpload.value.length === 0) {
    alert('请先选择文件');
    return;
  }

  // 1. 立即更新进度为1%，这是MD5计算前的最早时间点，确保进度条显示
  uploadProgress.value = 1;
  if (onProgressUpdate) {
    onProgressUpdate(1);
  }
  
  // 2. 立即显示全局进度条
  if (showUploadModal.value) {
    // 通知模态框更新进度
    const manager = getModalManager();
    const uploadModal = manager.activeModals[MODAL_TYPES.UPLOAD_FILE];
    if (uploadModal && uploadModal.props.onProgressUpdate) {
      uploadModal.props.onProgressUpdate(1);
    }
  }
  
  // 3. 确保UI更新，使用requestAnimationFrame确保浏览器渲染进度条
  if (typeof window !== 'undefined' && window.requestAnimationFrame) {
    await new Promise(resolve => requestAnimationFrame(resolve));
  }
  
  // 4. 开始处理其他准备工作
  loading.value = true;
  uploadStatus.value = 'preparing';
  
  // 创建abortController用于取消请求
  abortController = new AbortController();
  
  try {
    console.log('开始分块上传流程');
    
    // 更新进度，表示正在准备上传
    uploadProgress.value = 2;
    if (onProgressUpdate) {
      onProgressUpdate(2);
    }
    
    // 生成文件清单
    console.log('步骤1: 生成文件清单');
    // 更新进度，表示正在生成文件清单
    uploadProgress.value = 5;
    if (onProgressUpdate) {
      onProgressUpdate(5);
    }
    
    // 确保UI更新
    if (typeof window !== 'undefined' && window.requestAnimationFrame) {
      await new Promise(resolve => requestAnimationFrame(resolve));
    }
    
    // 开始MD5计算和文件清单生成
    fileList.value = await generateFileList(selectedFilesForUpload.value, (progress) => {
      // MD5计算进度，范围5-30%
      const md5Progress = 5 + Math.floor(progress * 25);
      uploadProgress.value = md5Progress;
      if (onProgressUpdate) {
        onProgressUpdate(md5Progress);
      }
    });
    console.log('文件清单生成完成:', fileList.value);
    
    // 步骤2: 检查是否存在未完成的上传任务，自动检测并恢复
    console.log('步骤2: 检查是否存在未完成的上传任务');
    // 更新进度，表示正在检查任务
    uploadProgress.value = 30;
    if (onProgressUpdate) {
      onProgressUpdate(30);
    }
    let taskId = null;
    let existingTask = null;
    
    // 获取所有本地未完成任务
    const localTasks = getLocalTasks();
    const pendingTasks = localTasks.filter(task => 
      task.status !== 'completed' && task.status !== 'failed'
    );
    
    // 检查是否有匹配的未完成任务
    if (pendingTasks.length > 0) {
      for (const task of pendingTasks) {
        // 比较任务中的文件与当前选择的文件是否匹配
        const hasMatchingFiles = task.files.some(taskFile => 
          fileList.value.some(selectedFile => selectedFile.name === taskFile.name)
        );
        
        if (hasMatchingFiles) {
          // 检查后端任务是否存在
          try {
            const progressResult = await audiosApi.getUploadProgress(task.taskId, { signal: abortController.signal });
            if (progressResult && progressResult.task) {
              // 后端任务存在，提示用户是否恢复
              const shouldResume = confirm(
                `检测到未完成的上传任务（任务ID: ${task.taskId}），包含与当前选择文件匹配的项，是否继续上传？`
              );
              
              if (shouldResume) {
                taskId = task.taskId;
                existingTask = task;
                console.log('恢复现有任务:', taskId);
                break;
              }
            }
          } catch (err) {
            console.error('检查任务进度失败:', err);
            // 任务不存在，跳过
            continue;
          }
        }
      }
    }
    
    // 如果没有找到匹配的任务，初始化新任务
    if (!taskId) {
      console.log('步骤3: 初始化新上传任务');
      // 更新进度，表示正在初始化任务
      uploadProgress.value = 40;
      if (onProgressUpdate) {
        onProgressUpdate(40);
      }
      const taskInitResult = await audiosApi.initUpload(undefined, { signal: abortController.signal });
      console.log('初始化上传任务结果:', taskInitResult);
      taskId = taskInitResult.taskId;
      console.log('创建新任务:', taskId);
    }
    
    // 检查文件清单是否为空
    if (fileList.value.length === 0) {
      throw new Error('没有找到支持的音频文件，请检查文件格式是否正确');
    }
    
    // 注册文件
    console.log('步骤3: 注册文件');
    // 更新进度，表示正在注册文件
    uploadProgress.value = 50;
    if (onProgressUpdate) {
      onProgressUpdate(50);
    }
    const registerResult = await audiosApi.registerUploadFiles(taskId, fileList.value, { signal: abortController.signal });
    console.log('文件注册结果:', registerResult);
    
    // 检查文件注册情况，处理重复文件
    if (registerResult.files.length === 0 && fileList.value.length > 0) {
      // 所有文件都未注册成功，可能是重复文件
      let errorMessage = registerResult.message || '文件注册失败';
      if (errorMessage.includes('成功注册 0 个文件')) {
        errorMessage = '所选文件已全部存在，请勿重复上传';
      }
      throw new Error(errorMessage);
    }
    
    if (registerResult.files.length < fileList.value.length) {
      // 部分文件未注册成功，可能是重复文件
      console.warn('部分文件注册失败或重复:', registerResult);
    }
    
    // 更新本地任务
    console.log('步骤4: 更新本地任务');
    let task;
    if (existingTask) {
      // 更新现有任务
      task = existingTask;
      task.status = 'uploading';
      task.files = fileList.value;
      task.totalFiles = fileList.value.length;
      task.totalSize = fileList.value.reduce((sum, file) => sum + file.size, 0);
      task.options = { ...uploadOptions.value };
      saveLocalTask(task);
    } else {
      // 创建新任务，直接使用对象字面量创建，避免调用initUploadTask
      task = {
        taskId,
        createdAt: new Date().toISOString(),
        status: 'uploading',
        totalFiles: fileList.value.length,
        completedFiles: 0,
        failedFiles: 0,
        totalSize: fileList.value.reduce((sum, file) => sum + file.size, 0),
        uploadedSize: 0,
        files: fileList.value,
        options: { ...uploadOptions.value }
      };
      // 只有当上传失败时才需要保存任务到本地，所以这里先不保存
      currentTask.value = task;
    }
    uploadTasks.value = getLocalTasks();
    console.log('本地任务更新完成:', task);
    
    // 开始上传
    console.log('步骤5: 开始上传');
    uploadStatus.value = 'uploading';
    
    // 上传所有文件
    console.log('步骤6: 上传所有文件');
    for (let i = 0; i < selectedFilesForUpload.value.length; i++) {
      console.log(`上传文件 ${i+1}/${selectedFilesForUpload.value.length}`);
      const file = selectedFilesForUpload.value[i];
      const fileInfo = fileList.value[i];
      const registeredFile = registerResult.files.find(f => f.filename === fileInfo.name);
      
      if (registeredFile) {
        console.log(`开始上传文件: ${fileInfo.name}，文件ID: ${registeredFile.fileId}`);
        await uploadFileInChunks(file, registeredFile, task, onProgressUpdate, abortController);
      }
    }
    
    // 上传完成后更新状态
    console.log('步骤7: 上传完成');
    uploadStatus.value = 'completed';
    // 更新任务状态为已完成
    task.status = 'completed';
    saveLocalTask(task);
    // 清理无效任务
    cleanInvalidTasks();
    uploadTasks.value = getLocalTasks();
    
    // 准备刷新列表
    uploadProgress.value = 90;
    if (onProgressUpdate) {
      onProgressUpdate(90);
    }
    // 刷新音频列表
    console.log('步骤8: 刷新音频列表');
    await fetchAudios();
    // 上传完成
    uploadProgress.value = 100;
    if (onProgressUpdate) {
      onProgressUpdate(100);
    }
    
    // 显示上传完成消息
    let message = `成功上传 ${task.completedFiles} 个音频文件`;
    if (task.failedFiles > 0) {
      message += `，失败 ${task.failedFiles} 个文件`;
    }
    alert(message);
    
    // 重置上传选项
    uploadOptions.value = {
      createTestCase: false,
      testType: 'api',
      playbackDeviceId: null,
      spl: 65.0,
      groupNameType: 'root',
      customGroupName: ''
    };
    
    setTimeout(() => {
      closeModal('uploadModal');
      uploadProgress.value = 0;
      selectedFilesForUpload.value = [];
      fileList.value = [];
      currentTask.value = null;
      uploadStatus.value = 'idle';
      currentUploadingFile.value = null;
      // 通知上传完成
      if (onUploadComplete) {
        onUploadComplete();
      }
    }, 1000);
  } catch (err) {
    console.error('上传失败:', err);
    if (err.name === 'AbortError') {
      console.log('上传任务已暂停');
      uploadStatus.value = 'paused';
      // 保留当前进度，不重置
      if (onUploadError) {
        onUploadError(err);
      }
    } else {
      console.error('错误堆栈:', err.stack);
      console.error('错误详细信息:', {
        code: err.code,
        detail: err.detail,
        errors: err.errors,
        message: err.message
      });
      alert('上传失败: ' + (err.message || '未知错误'));
      uploadStatus.value = 'failed';
      // 重置进度
      uploadProgress.value = 0;
      // 通知上传错误
      if (onUploadError) {
        onUploadError(err);
      }
    }
  } finally {
    loading.value = false;
    // 清理abortController
    if (abortController && uploadStatus.value !== 'paused') {
      abortController = null;
    }
  }
}

// 分片上传单个文件
async function uploadFileInChunks(file, registeredFile, task, onProgressUpdate, abortController) {
  const { fileId, filename } = registeredFile;
  // 确保有totalChunks和chunkSize，处理恢复上传的情况
  const totalChunks = registeredFile.totalChunks || registeredFile.total_chunks;
  // 默认chunkSize为10MB
  const chunkSize = registeredFile.chunkSize || 10 * 1024 * 1024;
  const fileName = typeof file === 'string' ? pathBasename(file) : file.name;
  
  currentUploadingFile.value = fileName;
  
  // 更新文件状态
  const fileItem = task.files.find(f => f.name === fileName);
  if (fileItem) {
    fileItem.status = 'uploading';
    // 立即保存任务状态，确保UI更新
    saveLocalTask(task);
    uploadTasks.value = [...uploadTasks.value]; // 触发响应式更新
  }
  
  try {
    // 分片上传
    for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex++) {
      // 计算分片范围
      const start = chunkIndex * chunkSize;
      const end = Math.min(start + chunkSize, file.size);
      
      // 获取分片数据
      let chunkData;
      if (typeof file === 'string') {
        // Electron环境：文件路径，这里简化处理，实际应该读取文件分片
        throw new Error('Electron环境的分片上传尚未实现');
      } else {
        // 浏览器环境：File对象
        chunkData = file.slice(start, end);
      }
      
      // 创建FormData
      const formData = new FormData();
      formData.append('fileId', fileId);
      formData.append('chunkIndex', chunkIndex);
      formData.append('totalChunks', totalChunks);
      formData.append('taskId', task.taskId);
      formData.append('chunk', chunkData);
      
      // 上传分片，传入signal支持取消
      const uploadResult = await audiosApi.uploadChunk(formData, { signal: abortController?.signal });
      
      // 更新进度
      if (fileItem) {
        fileItem.uploadedSize = uploadResult.uploadedSize;
        fileItem.completedChunks = uploadResult.completedChunks;
        fileItem.status = 'uploading';
      }
      
      // 更新任务进度
      task.uploadedSize = uploadResult.taskProgress.uploadedSize;
      task.completedFiles = uploadResult.taskProgress.completedFiles;
      task.status = uploadResult.taskProgress.status;
      
      // 更新全局进度
      const progress = Math.floor((task.uploadedSize / task.totalSize) * 100);
      uploadProgress.value = progress;
      if (onProgressUpdate) {
        onProgressUpdate(progress);
      }
      
      // 立即保存任务状态，确保UI实时更新
      saveLocalTask(task);
      uploadTasks.value = [...uploadTasks.value]; // 触发响应式更新
      
      // 实时更新统计信息，确保状态卡片及时刷新
      updateStats();
    }
    
    // 合并分片，传入signal支持取消
    const mergeData = {
      createTestCase: uploadOptions.value.createTestCase,
      testType: uploadOptions.value.testType,
      defaultPlaybackDeviceId: uploadOptions.value.playbackDeviceId,
      testCaseGroupName: getEffectiveGroupName(),
      audioType: uploadOptions.value.audioType || 'dry',
      translationDirectionId: uploadOptions.value.translationDirectionId || '',
      // 确保生成的用例直接继承音频标签
      inheritTags: true
    };
    
    // API测试不需要配置声压级，只有E2E测试需要
    if (uploadOptions.value.testType === 'e2e') {
      mergeData.defaultSpl = uploadOptions.value.spl;
    }
    
    const mergeResult = await audiosApi.mergeChunks(fileId, task.taskId, mergeData, { signal: abortController?.signal });
    
    // 更新文件状态
    if (fileItem) {
      fileItem.status = 'completed';
    }
    
    // 使用服务器返回的最新completedFiles值，避免重复计数
    if (mergeResult && mergeResult.taskProgress) {
      task.completedFiles = mergeResult.taskProgress.completedFiles;
    } else {
      // 如果服务器没有返回taskProgress，则确保completedFiles不会超过totalFiles
      task.completedFiles = Math.min(task.completedFiles + 1, task.totalFiles);
    }
    
    // 立即保存任务状态，确保UI实时更新
    saveLocalTask(task);
    uploadTasks.value = [...uploadTasks.value]; // 触发响应式更新
    
    // 更新统计信息，确保状态卡片实时显示最新数据
    updateStats();
  } catch (err) {
    console.error(`文件 ${fileName} 上传失败:`, err);
    if (err.name === 'AbortError') {
      // 请求被取消，更新文件和任务状态为暂停
      if (fileItem) {
        fileItem.status = 'paused';
      }
      task.status = 'paused';
      saveLocalTask(task);
      uploadTasks.value = [...uploadTasks.value]; // 触发响应式更新
      throw err; // 向上抛出取消错误
    } else {
      // 其他错误，更新文件和任务状态为失败
      if (fileItem) {
        fileItem.status = 'failed';
        fileItem.errorMessage = err.message || '未知错误';
        fileItem.errorCode = err.code || 500;
      }
      task.status = 'failed';
      task.failedFiles++;
      saveLocalTask(task);
      uploadTasks.value = [...uploadTasks.value]; // 触发响应式更新
    }
  }
}

// 恢复上传任务
async function resumeUploadTask(taskId) {
  console.log(`AudioImport: 恢复上传任务 - 任务ID ${taskId}`);
  const task = uploadTasks.value.find(t => t.taskId === taskId);
  if (!task) {
    console.error('未找到任务:', taskId);
    alert('恢复上传任务失败: 任务不存在');
    return;
  }
  
  currentTask.value = task;
  uploadStatus.value = 'uploading';
  
  try {
    // 获取任务进度
    let progressResult;
    try {
      progressResult = await audiosApi.getUploadProgress(taskId, { signal: abortController.signal });
    } catch (err) {
      // 任务不存在，可能是传统上传模式的任务（只存在于本地存储）
      console.error('获取上传进度失败:', err);
      
      // 检查是否为传统上传任务（没有调用后端initUpload）
      if (err.message === '任务不存在') {
        // 提示用户重新上传，因为传统上传任务无法恢复
        const shouldReupload = confirm(
          `该上传任务无法恢复（任务ID: ${taskId}），是否重新上传？`
        );
        
        if (shouldReupload) {
          // 删除旧任务
          removeLocalTask(taskId);
          uploadTasks.value = getLocalTasks();
          // 打开上传模态框
          showUploadModal.value = true;
        }
        uploadStatus.value = 'idle';
        currentTask.value = null;
        return;
      }
      
      // 其他错误继续抛出
      throw err;
    }
    
    // 更新本地任务状态
    task.status = progressResult.task.status;
    task.uploadedSize = progressResult.task.uploadedSize;
    task.completedFiles = progressResult.task.completedFiles;
    task.failedFiles = progressResult.task.failedFiles;
    
    // 更新文件状态
    for (const fileProgress of progressResult.files) {
      const localFile = task.files.find(f => f.name === fileProgress.filename);
      if (localFile) {
        localFile.status = fileProgress.status;
        localFile.uploadedSize = fileProgress.uploadedSize;
        localFile.completedChunks = fileProgress.completedChunks;
      }
    }
    
    saveLocalTask(task);
    
    // 检查是否有未完成的文件
    const incompleteFiles = progressResult.files.filter(f => f.status !== 'completed');
    if (incompleteFiles.length === 0) {
      // 所有文件都已完成，直接结束
      uploadStatus.value = 'completed';
      await fetchAudios();
      
      setTimeout(() => {
        uploadProgress.value = 0;
        currentTask.value = null;
        uploadStatus.value = 'idle';
        currentUploadingFile.value = null;
      }, 1000);
      return;
    }
    
    // 提示用户需要重新选择文件以继续上传
    const shouldSelectFiles = confirm(
      `需要重新选择文件以继续上传（${incompleteFiles.length} 个文件未完成），是否选择文件？`
    );
    
    if (!shouldSelectFiles) {
      // 用户取消，重置状态
      uploadStatus.value = 'idle';
      currentTask.value = null;
      return;
    }
    
    // 打开上传模态框，让用户重新选择文件
    showUploadModal.value = true;
    
    // 重置状态
    uploadStatus.value = 'idle';
    currentTask.value = null;
    
    // 提示用户选择相同的文件以继续上传
    alert('请选择与之前相同的文件以继续上传。系统将自动检测并恢复未完成的上传任务。');
    
  } catch (err) {
    console.error('恢复上传任务失败:', err);
    alert('恢复上传任务失败: ' + err.message);
    uploadStatus.value = 'failed';
  }
}

// 重试上传失败的文件
async function retryFailedFiles(taskId) {
  console.log(`AudioImport: 重试上传失败的文件 - 任务ID ${taskId}`);
  const task = uploadTasks.value.find(t => t.taskId === taskId);
  if (!task) {
    console.error('未找到任务:', taskId);
    alert('重试上传失败: 任务不存在');
    return;
  }
  
  currentTask.value = task;
  uploadStatus.value = 'uploading';
  
  try {
    // 获取失败的文件
    const failedFiles = task.files.filter(f => f.status === 'failed');
    if (failedFiles.length === 0) {
      alert('没有失败的文件需要重试');
      uploadStatus.value = 'idle';
      currentTask.value = null;
      return;
    }
    
    // 更新任务状态
    task.status = 'uploading';
    saveLocalTask(task);
    
    // 重试上传失败的文件
    for (const failedFile of failedFiles) {
      try {
        // 查找对应的原始文件对象
        const originalFile = selectedFilesForUpload.value.find(f => f.name === failedFile.name);
        if (!originalFile) {
          console.error('找不到原始文件:', failedFile.name);
          continue;
        }
        
        // 重置文件状态
        failedFile.status = 'uploading';
        delete failedFile.errorMessage;
        delete failedFile.errorCode;
        saveLocalTask(task);
        
        // 重新上传文件
        const formData = new FormData();
        formData.append('file', originalFile);
        formData.append('relativePath', failedFile.relativePath || failedFile.name);
        formData.append('taskId', taskId);
        
        // 添加测试用例生成选项
        if (folderImportOptions.value.createTestCase) {
          formData.append('createTestCase', 'true');
          formData.append('testType', folderImportOptions.value.testType);
          if (folderImportOptions.value.playbackDeviceId) {
            formData.append('defaultPlaybackDeviceId', folderImportOptions.value.playbackDeviceId.toString());
          }
          // API测试不需要配置声压级，只有E2E测试需要
          if (folderImportOptions.value.testType === 'e2e') {
            formData.append('defaultSpl', folderImportOptions.value.spl.toString());
          }
          const groupName = getFolderImportGroupName(task.groupName || '');
          if (groupName) {
            formData.append('testCaseGroupName', groupName);
          }
          // 确保生成的用例直接继承音频标签
          formData.append('inheritTags', 'true');
        }
        
        const response = await audiosApi.upload(formData);
        
        // 更新文件状态
        failedFile.status = 'completed';
        failedFile.uploadedSize = failedFile.size;
        task.completedFiles++;
        task.failedFiles--;
        task.uploadedSize += failedFile.size;
        
        saveLocalTask(task);
        
        // 更新进度
        uploadProgress.value = Math.floor((task.uploadedSize / task.totalSize) * 90);
      } catch (err) {
        console.error('重试上传文件失败:', failedFile.name, err);
        failedFile.status = 'failed';
        failedFile.errorMessage = err.message || '未知错误';
        failedFile.errorCode = err.code || 500;
        saveLocalTask(task);
      }
    }
    
    // 更新任务状态
    if (task.failedFiles === 0) {
      task.status = 'completed';
    } else {
      task.status = 'partial_completed';
    }
    
    saveLocalTask(task);
    uploadTasks.value = getLocalTasks();
    
    // 刷新音频列表
    await fetchAudios();
    
    // 显示结果
    alert(`重试完成：成功上传 ${failedFiles.length - task.failedFiles} 个文件，失败 ${task.failedFiles} 个文件`);
    
    uploadStatus.value = 'idle';
    currentTask.value = null;
  } catch (err) {
    console.error('重试上传失败:', err);
    alert('重试上传失败: ' + err.message);
    uploadStatus.value = 'failed';
    currentTask.value = null;
  }
}

// 开始上传
async function startUpload(onProgressUpdate, onUploadComplete, onUploadError, onCancelUpload) {
  // 检查是否支持分片上传
  try {
    // 尝试初始化任务，检查后端是否支持分片上传
    await startChunkUpload(onProgressUpdate, onUploadComplete, onUploadError, onCancelUpload);
  } catch (err) {
    console.error('分片上传失败，回退到传统上传:', err);
    // 回退到传统上传
    await startTraditionalUpload(onProgressUpdate, onUploadComplete, onUploadError, onCancelUpload);
  }
}

// 传统上传实现（兼容旧版）
async function startTraditionalUpload(onProgressUpdate, onUploadComplete, onUploadError, onCancelUpload) {
  if (selectedFilesForUpload.value.length === 0) {
    alert('请先选择文件');
    return;
  }

  // 1. 立即更新进度为1%，这是MD5计算前的最早时间点，确保进度条显示
  uploadProgress.value = 1;
  if (onProgressUpdate) {
    onProgressUpdate(1);
  }
  
  // 2. 立即显示全局进度条
  if (showUploadModal.value) {
    // 通知模态框更新进度
    const manager = getModalManager();
    const uploadModal = manager.activeModals[MODAL_TYPES.UPLOAD_FILE];
    if (uploadModal && uploadModal.props.onProgressUpdate) {
      uploadModal.props.onProgressUpdate(1);
    }
  }
  
  // 3. 确保UI更新，使用requestAnimationFrame确保浏览器渲染进度条
  if (typeof window !== 'undefined' && window.requestAnimationFrame) {
    await new Promise(resolve => requestAnimationFrame(resolve));
  }
  
  // 4. 开始处理其他准备工作
  loading.value = true;
  uploadStatus.value = 'preparing';
  
  // 创建abortController用于取消请求
  abortController = new AbortController();
  
  try {
    // 更新进度，表示正在准备上传
    uploadProgress.value = 2;
    if (onProgressUpdate) {
      onProgressUpdate(2);
    }
    
    // 生成文件清单
    console.log('生成传统上传文件清单');
    // 更新进度，表示正在生成文件清单
    uploadProgress.value = 5;
    if (onProgressUpdate) {
      onProgressUpdate(5);
    }
    
    // 确保UI更新
    if (typeof window !== 'undefined' && window.requestAnimationFrame) {
      await new Promise(resolve => requestAnimationFrame(resolve));
    }
    
    // 开始MD5计算和文件清单生成
    fileList.value = await generateFileList(selectedFilesForUpload.value, (progress) => {
      // MD5计算进度，范围5-30%
      const md5Progress = 5 + Math.floor(progress * 25);
      uploadProgress.value = md5Progress;
      if (onProgressUpdate) {
        onProgressUpdate(md5Progress);
      }
    });
    
    // 初始化上传任务，直接创建而不保存到本地
    const task = {
      taskId: generateTaskId(),
      createdAt: new Date().toISOString(),
      status: 'uploading',
      totalFiles: fileList.value.length,
      completedFiles: 0,
      failedFiles: 0,
      totalSize: fileList.value.reduce((sum, file) => sum + file.size, 0),
      uploadedSize: 0,
      files: fileList.value,
      options: { ...uploadOptions.value }
    };
    currentTask.value = task;
    
    const totalFiles = selectedFilesForUpload.value.length;
    let createdTestCases = [];
    
    // 更新上传状态
    uploadStatus.value = 'uploading';
    // 更新进度，表示开始上传
    uploadProgress.value = 30;
    if (onProgressUpdate) {
      onProgressUpdate(30);
    }
    
    // 遍历上传所有文件
    for (let i = 0; i < totalFiles; i++) {
      const fileItem = selectedFilesForUpload.value[i];
      await uploadSingleFile(fileItem, task, i, onProgressUpdate);
      // 只有当上传失败时才保存任务到本地
      if (task.status === 'failed') {
        saveLocalTask(task);
        uploadTasks.value = getLocalTasks();
      }
    }
    
    // 上传完成后更新状态
    uploadStatus.value = 'completed';
    // 更新任务状态为已完成
    task.status = 'completed';
    saveLocalTask(task);
    // 清理无效任务
    cleanInvalidTasks();
    uploadTasks.value = getLocalTasks();
    
    // 准备刷新列表
    uploadProgress.value = 90;
    if (onProgressUpdate) {
      onProgressUpdate(90);
    }
    // 刷新音频列表
    await fetchAudios();
    // 上传完成
    uploadProgress.value = 100;
    if (onProgressUpdate) {
      onProgressUpdate(100);
    }
    
    // 显示上传完成消息
    let message = `成功上传 ${task.completedFiles} 个音频文件`;
    if (task.failedFiles > 0) {
      message += `，失败 ${task.failedFiles} 个文件`;
    }
    if (createdTestCases.length > 0) {
      message += `，并创建了 ${createdTestCases.length} 个测试用例`;
    }
    alert(message);
    
    // 重置上传选项
    uploadOptions.value = {
      createTestCase: false,
      testType: 'api',
      playbackDeviceId: null,
      spl: 65.0,
      groupNameType: 'root',
      customGroupName: ''
    };
    
    setTimeout(() => {
      closeModal('uploadModal');
      uploadProgress.value = 0;
      selectedFilesForUpload.value = [];
      fileList.value = [];
      currentTask.value = null;
      uploadStatus.value = 'idle';
      currentUploadingFile.value = null;
      // 通知上传完成
      if (onUploadComplete) {
        onUploadComplete();
      }
    }, 1000);
  } catch (err) {
    console.error('上传失败:', err);
    alert('上传失败: ' + err.message);
    uploadStatus.value = 'failed';
    // 重置进度
    uploadProgress.value = 0;
    // 通知上传错误
    if (onUploadError) {
      onUploadError(err);
    }
  } finally {
    loading.value = false;
  }
}

