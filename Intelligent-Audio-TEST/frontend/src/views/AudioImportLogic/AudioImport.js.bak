// 处理批量文件夹导入确认
async function handleFolderImport(event) {
  console.log('AudioImport: 处理批量文件夹导入', event);
  const { config, files } = event;
  
  if (!files || files.length === 0) {
    alert('请先选择文件夹');
    return;
  }
  
  // 更新folderImportOptions
  folderImportOptions.value = {
    createTestCase: config.createTestCase || false,
    testType: config.testType || 'api',
    audioType: config.audioType || 'dry',
    playbackDeviceId: config.playbackDeviceId || null,
    spl: config.defaultSpl || 65.0,
    groupNameType: config.groupNameType || 'root',
    customGroupName: config.customGroupName || '',
    sourceLanguage: config.sourceLanguage || '',
    translationDirectionId: config.translationDirectionId || ''
  };
  
  // 更新uploadOptions，以便在startUpload中使用
  uploadOptions.value = {
    createTestCase: config.createTestCase || false,
    testType: config.testType || 'api',
    audioType: config.audioType || 'dry',
    playbackDeviceId: config.playbackDeviceId || null,
    spl: config.defaultSpl || 65.0,
    groupNameType: config.groupNameType || 'root',
    customGroupName: config.customGroupName || '',
    sourceLanguage: config.sourceLanguage || '',
    translationDirectionId: config.translationDirectionId || ''
  };
  
  // 关闭模态框
  const manager = getModalManager();
  manager.closeModal(MODAL_TYPES.FOLDER_IMPORT);
  
  // 1. 立即更新进度为1%，确保进度条显示
  uploadProgress.value = 1;
  
  // 2. 确保UI更新
  if (typeof window !== 'undefined' && window.requestAnimationFrame) {
    await new Promise(resolve => requestAnimationFrame(resolve));
  }
  
  // 使用模态框返回的文件进行上传
  loading.value = true;
  
  try {
    // 设置选中的文件
    selectedFilesForUpload.value = files;
    
    // 生成文件清单
    fileList.value = await generateFileList(files, (progress) => {
      // 实时更新MD5计算进度
      const md5Progress = 1 + Math.floor(progress * 29); // 1% + 29% = 30%
      uploadProgress.value = md5Progress;
    });
    
    if (fileList.value.length === 0) {
      throw new Error('没有找到支持的音频文件，请检查文件格式是否正确');
    }
    
    // 开始上传
    await startUpload();
  } catch (err) {
    console.error('文件夹导入失败:', err);
    if (err.name === 'AbortError') {
      console.log('文件夹导入任务已暂停');
      uploadStatus.value = 'paused';
      // 保留当前进度，不重置
    } else {
      alert('导入失败: ' + err.message);
      uploadProgress.value = 0;
    }
  } finally {
    if (uploadStatus.value !== 'paused') {
      loading.value = false;
    }
  }
}

// 执行批量文件夹导入（使用配置）
async function performFolderImportWithConfig() {
  console.log('AudioImport: 执行批量文件夹导入');
  
  try {
    if (window.electronAPI && window.electronAPI.invoke) {
      // Electron环境：使用IPC调用选择文件夹
      const folderPath = await window.electronAPI.invoke('select-folder');
      if (!folderPath) return;

      loading.value = true;
      
      // 获取文件夹中的所有音频文件
      const groupName = getFolderImportGroupName(pathBasename(folderPath));
      const response = await performFolderImport(folderPath, true, groupName);
      alert(response.message || `成功导入 ${response.importedCount} 个音频文件${response.testCaseCount > 0 ? `，并创建了 ${response.testCaseCount} 个测试用例` : ''}`);
      fetchAudios();
    } else {
      // 浏览器环境：使用HTML5的文件夹选择API
      return new Promise((resolve) => {
        const input = document.createElement('input');
        input.type = 'file';
        input.webkitdirectory = true;
        input.multiple = true;
        input.accept = '.mp3,.wav,.flac,.aac,.m4a';
        
        input.onchange = async (e) => {
          const files = Array.from(e.target.files);
          if (files.length === 0) {
            resolve();
            return;
          }
          
          loading.value = true;
          // 设置进度为1%，在计算MD5前显示进度条
          uploadProgress.value = 1;
          
          try {
            const result = await performFolderImport(files, false);
            
            uploadProgress.value = 90;
            await fetchAudios();
            uploadProgress.value = 100;
            
            setTimeout(() => {
              uploadProgress.value = 0;
            }, 500);
            
            alert(`成功导入 ${result.importedCount} 个音频文件${result.testCaseCount > 0 ? `，并创建了 ${result.testCaseCount} 个测试用例` : ''}`);
          } catch (err) {
            console.error('文件夹导入失败:', err);
            alert('文件夹导入失败: ' + err.message);
            uploadProgress.value = 0;
          } finally {
            loading.value = false;
            resolve();
          }
        };
        
        input.click();
      });
    }
  } catch (err) {
    console.error('文件夹导入失败:', err);
    alert('文件夹导入失败: ' + err.message);
    loading.value = false;
  }
}

// 关闭模态框
function closeModal(modalName) {
  switch(modalName) {
    case 'uploadModal':
      useModalStore().closeUploadModal();
      break;
    case 'urlImportModal':
      useModalStore().closeUrlImportModal();
      break;
    case 'convertAudioModal':
      useModalStore().closeConvertModal();
      break;
    case 'metadataModal':
       useModalStore().closeMetadataModal();
       break;
    case 'folderImportModal':
      const manager = getModalManager();
      manager.closeModal(MODAL_TYPES.FOLDER_IMPORT);
      break;
  }
}

// 上传任务管理
const uploadTasks = ref(getLocalTasks());
const currentTask = ref(null);
const selectedFilesForUpload = ref([]);
const fileList = ref([]); // 文件清单
const currentUploadingFile = ref(null);
const uploadStatus = ref('idle'); // idle, preparing, uploading, paused, completed, failed

// 取消正在进行的上传任务的信号
let abortController = null;

// 暂停上传任务
function pauseUploadTask() {
  try {
    if (uploadStatus?.value === 'uploading' || uploadStatus?.value === 'preparing') {
      uploadStatus.value = 'paused';
      // 保存任务状态
      if (currentTask?.value) {
        currentTask.value.status = 'paused';
        saveLocalTask(currentTask.value);
        uploadTasks.value = getLocalTasks();
      }
      // 取消当前请求
      if (abortController) {
        abortController.abort();
        abortController = null;
      }
      console.log('上传任务已暂停');
    }
  } catch (error) {
    console.error('暂停上传任务失败:', error);
    // 如果ref变量未定义，忽略错误
  }
}

// 检查文件是否支持
function isFileSupported(fileName) {
  const supportedExts = ['mp3', 'wav', 'flac', 'aac', 'm4a', 'ogg', 'wma', 'alac', 'opus'];
  const ext = fileName.toLowerCase().split('.').pop();
  return supportedExts.includes(ext);
}

// 文件上传前验证
function validateFile(file) {
  const errors = [];
  
  // 检查文件格式
  if (!isFileSupported(file.name)) {
    errors.push(`文件格式不支持: ${file.name}`);
  }
  
  // 检查文件大小（最大100MB）
  const maxSize = 100 * 1024 * 1024; // 100MB
  if (file.size > maxSize) {
    errors.push(`文件过大: ${file.name} (最大支持100MB)`);
  }
  
  return errors;
}

// 批量验证文件
function validateFiles(files) {
  const allErrors = [];
  const validFiles = [];
  
  for (const file of files) {
    const errors = validateFile(file);
    if (errors.length === 0) {
      validFiles.push(file);
    } else {
      allErrors.push(...errors);
    }
  }
  
  return {
    validFiles,
    errors: allErrors
  };
}

// 生成文件清单
async function generateFileList(files, onProgressUpdate = null) {
  const list = [];
  const totalFiles = files.length;
  let processedFiles = 0;
  
  // 立即更新进度，表示开始处理
  if (onProgressUpdate) {
    onProgressUpdate(0.01);
    // 使用requestAnimationFrame确保UI更新
    if (typeof window !== 'undefined' && window.requestAnimationFrame) {
      await new Promise(resolve => requestAnimationFrame(resolve));
    }
  }
  
  // 使用Promise.allSettled并发处理文件，提高性能
  const processingPromises = files.map(async (file, index) => {
    const fileName = typeof file === 'string' ? pathBasename(file) : file.name;
    
    // 跳过不支持的文件格式
    if (!isFileSupported(fileName)) {
      processedFiles++;
      if (onProgressUpdate) {
        const progress = Math.min(1, processedFiles / totalFiles);
        onProgressUpdate(progress);
      }
      return null;
    }
    
    // 获取相对路径，包含原文件结构
    const relativePath = typeof file === 'string' ? file : file.webkitRelativePath || fileName;
    const fileSize = typeof file === 'string' ? 0 : file.size;
    
    // 创建fileItem对象
    const fileItem = {
      name: fileName,
      path: relativePath,
      relativePath: relativePath, // 新增relativePath字段，用于保持原文件结构
      size: fileSize,
      md5: '',
      status: 'pending',
      uploadedSize: 0,
      totalSize: fileSize
    };
    
    // 如果是浏览器环境下的File对象，计算MD5
    if (typeof file !== 'string') {
      // 传递进度回调，实时更新MD5计算进度
      const md5ProgressCallback = (md5Progress) => {
        if (onProgressUpdate) {
          // 计算当前文件的处理进度（包含MD5计算）
          const currentFileProgress = (index + md5Progress) / totalFiles;
          onProgressUpdate(currentFileProgress);
        }
      };
      
      // 计算MD5
      try {
        fileItem.md5 = await calculateFileMD5(file, md5ProgressCallback);
      } catch (error) {
        console.error(`计算文件 ${fileName} 的MD5失败:`, error);
        fileItem.md5 = '';
      }
    } else {
      fileItem.md5 = '';
    }
    
    processedFiles++;
    // 计算当前总进度并调用回调
    if (onProgressUpdate) {
      const progress = Math.min(1, processedFiles / totalFiles);
      onProgressUpdate(progress);
    }
    
    return fileItem;
  });
  
  // 等待所有文件处理完成
  const results = await Promise.allSettled(processingPromises);
  
  // 收集成功处理的文件
  for (const result of results) {
    if (result.status === 'fulfilled' && result.value) {
      list.push(result.value);
    }
  }
  
  // 最终更新进度为100%
  if (onProgressUpdate) {
    onProgressUpdate(1);
  }
  
  return list;
}

// 初始化任务
function initUploadTask() {
  // 检查是否已经有相同文件列表的待上传任务
  const existingTask = uploadTasks.value.find(task => {
    if (task.status !== 'preparing' && task.status !== 'pending') {
      return false;
    }
    
    // 比较文件数量
    if (task.totalFiles !== fileList.value.length) {
      return false;
    }
    
    // 比较文件名和大小
    const taskFileNames = task.files.map(f => `${f.name}_${f.size}`).sort();
    const currentFileNames = fileList.value.map(f => `${f.name}_${f.size}`).sort();
    
    return taskFileNames.join(',') === currentFileNames.join(',');
  });
  
  if (existingTask) {
    console.log('使用现有待上传任务:', existingTask.taskId);
    currentTask.value = existingTask;
    return existingTask;
  }
  
  const taskId = generateTaskId();
  const task = {
    taskId,
    createdAt: new Date().toISOString(),
    status: 'preparing',
    totalFiles: fileList.value.length,
    completedFiles: 0,
    failedFiles: 0,
    totalSize: fileList.value.reduce((sum, file) => sum + file.size, 0),
    uploadedSize: 0,
    files: fileList.value,
    options: { ...uploadOptions.value }
  };
  
  currentTask.value = task;
  return task;
}

// 上传单个文件
async function uploadSingleFile(file, task, fileIndex, onProgressUpdate) {
  if (typeof file === 'string') {
    // Electron环境下处理文件路径
    return await uploadElectronFile(file, task, fileIndex, onProgressUpdate);
  }
  
  // 浏览器环境下处理File对象
  const fileItem = task.files[fileIndex];
  fileItem.status = 'uploading';
  currentUploadingFile.value = fileItem.name;
  
  const formData = new FormData();
  formData.append('file', file);
  formData.append('taskId', task.taskId);
  
  // 添加音频类型
  formData.append('audioType', uploadOptions.value.audioType || 'dry');
  formData.append('sourceLanguage', uploadOptions.value.sourceLanguage || '');
  
  // 添加翻译方向ID
  // 情况1：提示词音频
  // 情况2：非提示词音频但勾选了生成测试用例
  if ((uploadOptions.value.audioType === 'prompt' || uploadOptions.value.createTestCase) && uploadOptions.value.translationDirectionId) {
    formData.append('translationDirectionId', uploadOptions.value.translationDirectionId);
  }
  
  // 添加测试用例生成选项
      if (uploadOptions.value.createTestCase) {
        formData.append('createTestCase', 'true');
        formData.append('testType', uploadOptions.value.testType);
        if (uploadOptions.value.playbackDeviceId) {
          formData.append('defaultPlaybackDeviceId', uploadOptions.value.playbackDeviceId.toString());
        }
        // API测试不需要配置声压级，只有E2E测试需要
        if (uploadOptions.value.testType === 'e2e') {
          formData.append('defaultSpl', uploadOptions.value.spl.toString());
        }
        const groupName = getEffectiveGroupName();
        if (groupName) {
          formData.append('testCaseGroupName', groupName);
        }
        // 确保生成的用例直接继承音频标签
        formData.append('inheritTags', 'true');
      }
  
  try {
    // 模拟进度更新（传统上传无法获取实时进度，使用模拟进度）
    let progress = Math.floor((task.completedFiles / task.totalFiles) * 100);
    uploadProgress.value = progress;
    if (onProgressUpdate) {
      onProgressUpdate(progress);
    }
    
    const response = await audiosApi.upload(formData);
    fileItem.status = 'completed';
    fileItem.uploadedSize = fileItem.size;
    // 确保completedFiles不会超过totalFiles
    task.completedFiles = Math.min(task.completedFiles + 1, task.totalFiles);
    updateUploadProgress(task);
    
    // 更新进度
    progress = Math.floor((task.completedFiles / task.totalFiles) * 100);
    uploadProgress.value = progress;
    if (onProgressUpdate) {
      onProgressUpdate(progress);
    }
    
    // 上传成功不需要保存到本地
    return true;
  } catch (error) {
    console.error('上传失败:', error);
    fileItem.status = 'failed';
    task.status = 'failed';
    task.failedFiles++;
    updateUploadProgress(task);
    saveLocalTask(task);
    uploadTasks.value = getLocalTasks();
    return false;
  }
}

// 更新上传进度
function updateUploadProgress(task) {
  const uploadedSize = task.files.reduce((sum, file) => sum + file.uploadedSize, 0);
  task.uploadedSize = uploadedSize;
  uploadProgress.value = Math.floor((uploadedSize / task.totalSize) * 100);
  // 实时更新统计信息，确保状态卡片及时刷新
  updateStats();
}

// 处理Electron环境下的文件上传
async function uploadElectronFile(filePath, task, fileIndex, onProgressUpdate) {
  const fileItem = task.files[fileIndex];
  fileItem.status = 'uploading';
  currentUploadingFile.value = fileItem.name;
  
  try {
    // 模拟进度更新
    let progress = Math.floor((task.completedFiles / task.totalFiles) * 100);
    uploadProgress.value = progress;
    if (onProgressUpdate) {
      onProgressUpdate(progress);
    }
    
    const response = await audiosApi.upload({
      file: filePath,
      audioType: task.options.audioType || 'dry',
      createTestCase: task.options.createTestCase,
      testType: task.options.testType,
      defaultPlaybackDeviceId: task.options.playbackDeviceId,
      defaultSpl: task.options.spl,
      testCaseGroupName: getEffectiveGroupName(),
      taskId: task.taskId
    });
    
    fileItem.status = 'completed';
    fileItem.uploadedSize = fileItem.size;
    // 确保completedFiles不会超过totalFiles
    task.completedFiles = Math.min(task.completedFiles + 1, task.totalFiles);
    updateUploadProgress(task);
    
    // 更新进度
    progress = Math.floor((task.completedFiles / task.totalFiles) * 100);
    uploadProgress.value = progress;
    if (onProgressUpdate) {
      onProgressUpdate(progress);
    }
    
    if (task.status !== 'failed') {
      // 只有恢复的任务才需要保存到本地
      if (existingTask) {
        saveLocalTask(task);
      }
    }
    return true;
  } catch (error) {
    console.error('Electron文件上传失败:', error);
    fileItem.status = 'failed';
    task.status = 'failed';
    task.failedFiles++;
    updateUploadProgress(task);
    saveLocalTask(task);
    uploadTasks.value = getLocalTasks();
    return false;
  }
}

async function pickFiles() {
  try {
    if (window.electronAPI && window.electronAPI.invoke) {
      // Electron环境下使用IPC调用
      const files = await window.electronAPI.invoke('select-file', {
        filters: [{ name: 'Audio Files', extensions: ['mp3', 'wav', 'flac', 'aac'] }]
      });
      if (files && files.length > 0) {
        selectedFilesForUpload.value = files;
        // 生成文件清单
        fileList.value = await generateFileList(files);
      }
    } else {
      // 浏览器环境下使用HTML5文件选择器
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = '.mp3,.wav,.flac,.aac';
      input.multiple = true;
      
      return new Promise((resolve) => {
        input.onchange = async (e) => {
          const files = Array.from(e.target.files);
          if (files.length > 0) {
            selectedFilesForUpload.value = files;
            // 生成文件清单
            fileList.value = await generateFileList(files);
          }
          resolve();
        };
        input.click();
      });
    }
  } catch (err) {
    console.error('选择文件失败:', err);
  }
}

// 处理拖拽上传
function handleDrop(event) {
  const files = event.dataTransfer.files;
  if (window.electronAPI && window.electronAPI.invoke) {
    // Electron环境下使用文件路径
    selectedFilesForUpload.value = Array.from(files).map(f => f.path);
  } else {
    // 浏览器环境下使用文件对象
    selectedFilesForUpload.value = Array.from(files);
  }
  console.log('拖拽上传文件:', selectedFilesForUpload.value);
}







// 清理无效任务
function cleanInvalidTasks() {
  const now = new Date().getTime();
  const dayMs = 24 * 60 * 60 * 1000; // 24小时
  const hourMs = 60 * 60 * 1000; // 1小时
  
  const tasks = getLocalTasks();
  const validTasks = tasks.filter(task => {
    const taskTime = new Date(task.createdAt).getTime();
    const taskAge = now - taskTime;
    
    // 已经完成或失败的任务，超过24小时则清理
    if (['completed', 'failed'].includes(task.status)) {
      return taskAge < dayMs;
    }
    
    // 状态为待上传或准备中，但创建时间超过1小时则清理
    if (['pending', 'preparing'].includes(task.status)) {
      return taskAge < hourMs;
    }
    
    // 其他状态的任务保留
    return true;
  });
  
  if (validTasks.length !== tasks.length) {
    localStorage.setItem('audioUploadTasks', JSON.stringify(validTasks));
    uploadTasks.value = validTasks;
    console.log(`清理了 ${tasks.length - validTasks.length} 个无效任务`);
  }
}

// 检查并恢复未完成的上传任务（供组件调用）
async function checkAndResumeTasks() {
  // 先清理无效任务
  cleanInvalidTasks();
  
  const tasks = getLocalTasks();
  if (tasks.length === 0) {
    return;
  }
  
  // 过滤出未完成的任务
  const pendingTasks = tasks.filter(task => 
    task.status !== 'completed' && task.status !== 'failed'
  );
  
  if (pendingTasks.length === 0) {
    return;
  }
  
  // 询问用户是否恢复上传
  const task = pendingTasks[0]; // 只恢复最新的一个任务
  const shouldResume = confirm(
    `检测到未完成的上传任务（${task.completedFiles}/${task.totalFiles} 个文件，已上传 ${formatFileSize(task.uploadedSize)}/${formatFileSize(task.totalSize)}），是否继续上传？`
  );
  
  if (shouldResume) {
    // 恢复任务
    await resumeUploadTask(task.taskId);
  } else {
    // 删除任务
    removeLocalTask(task.taskId);
    uploadTasks.value = getLocalTasks();
  }
}

// 批量从文件夹导入 - 打开全局模态框
function batchImportFromFolder() {
