// 分页导航
function prevPage() {
  console.log('AudioImport: 分页 - 上一页');
  if (currentPage.value > 1) {
    currentPage.value--;
    fetchAudios();
  }
}

function nextPage() {
  console.log('AudioImport: 分页 - 下一页');
  if (currentPage.value < totalPages.value) {
    currentPage.value++;
    fetchAudios();
  }
}

function handleGoToPage(page) {
  console.log(`AudioImport: 分页 - 跳转到第 ${page} 页`);
  currentPage.value = page;
  fetchAudios();
}

function handlePageSizeChange(size) {
  console.log(`AudioImport: 分页 - 每页显示 ${size} 条`);
  pageSize.value = size;
  currentPage.value = 1;
  fetchAudios();
}



