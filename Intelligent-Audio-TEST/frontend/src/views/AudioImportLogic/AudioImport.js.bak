  openFolderImportModal();
}

// 确认并执行批量文件夹导入
async function confirmFolderImport() {
  console.log('[GlobalModal] AudioImport: 确认批量文件夹导入');
  const manager = getModalManager();
  manager.closeModal(MODAL_TYPES.FOLDER_IMPORT);
  
  try {
    if (window.electronAPI && window.electronAPI.invoke) {
      // Electron环境：使用IPC调用选择文件夹
      const folderPath = await window.electronAPI.invoke('select-folder');
      if (!folderPath) return;

      loading.value = true;
      
      // 获取文件夹中的所有音频文件
      const groupName = getFolderImportGroupName(pathBasename(folderPath));
      const response = await performFolderImport(folderPath, true, groupName);
      alert(response.message || `成功导入 ${response.importedCount} 个音频文件${response.testCaseCount > 0 ? `，并创建了 ${response.testCaseCount} 个测试用例` : ''}`);
      fetchAudios();
    } else {
      // 浏览器环境：使用HTML5的文件夹选择API
      return new Promise((resolve) => {
        const input = document.createElement('input');
        input.type = 'file';
        input.webkitdirectory = true;
        input.multiple = true;
        input.accept = '.mp3,.wav,.flac,.aac';
        
        input.onchange = async (e) => {
          const files = Array.from(e.target.files);
          if (files.length === 0) {
            resolve();
            return;
          }
          
          loading.value = true;
          uploadProgress.value = 0;
          
          try {
            const result = await performFolderImport(files, false);
            
            uploadProgress.value = 90;
            await fetchAudios();
            uploadProgress.value = 100;
            
            setTimeout(() => {
              uploadProgress.value = 0;
            }, 500);
            
            alert(`成功导入 ${result.importedCount} 个音频文件${result.testCaseCount > 0 ? `，并创建了 ${result.testCaseCount} 个测试用例` : ''}`);
          } catch (err) {
            console.error('文件夹导入失败:', err);
            alert('文件夹导入失败: ' + err.message);
            uploadProgress.value = 0;
          } finally {
            loading.value = false;
            resolve();
          }
        };
        
        input.click();
      });
    }
  } catch (err) {
    console.error('文件夹导入失败:', err);
    alert('文件夹导入失败: ' + err.message);
    loading.value = false;
  }
}

// 执行批量文件夹导入的实际逻辑
async function performFolderImport(source, isElectron, groupName = null) {
  let importedCount = 0;
  let testCaseCount = 0;
  
  if (isElectron) {
    // Electron 环境
    const folderImportParams = {
      folder_path: source,
      audioType: folderImportOptions.value.audioType || 'dry',
      createTestCase: folderImportOptions.value.createTestCase,
      testType: folderImportOptions.value.testType,
      defaultPlaybackDeviceId: folderImportOptions.value.playbackDeviceId,
      testCaseGroupName: groupName,
      // 确保生成的用例直接继承音频标签
      inheritTags: true
    };
    
    // API测试不需要配置声压级，只有E2E测试需要
    if (folderImportOptions.value.testType === 'e2e') {
      folderImportParams.defaultSpl = folderImportOptions.value.spl;
    }
    
    const response = await audiosApi.folderImport(folderImportParams, { signal: abortController?.signal });
    return {
      importedCount: response.data?.count || 0,
      testCaseCount: response.data?.testCaseCount || 0,
      message: response.message
    };
  } else {
    // 浏览器环境
    const files = source;
    const totalFiles = files.length;
    
    // 获取选中的文件夹名
    let rootFolderName = '';
    if (files[0] && files[0].webkitRelativePath) {
      const pathParts = files[0].webkitRelativePath.split('/');
      if (pathParts.length > 0) {
        rootFolderName = pathParts[0];
      }
    }
    
    const supportedAudioExts = ['mp3', 'wav', 'flac', 'aac', 'm4a', 'ogg', 'wma', 'alac', 'opus'];
    
    // 文件验证
    const validationResult = validateFiles(files);
    if (validationResult.errors.length > 0) {
      // 显示验证错误
      alert(`文件验证失败：\n${validationResult.errors.join('\n')}`);
      return { importedCount: 0, testCaseCount: 0 };
    }
    
    // 只处理支持的音频文件
    const audioFiles = validationResult.validFiles;
    
    if (audioFiles.length === 0) {
      alert('没有符合条件的音频文件');
      return { importedCount: 0, testCaseCount: 0 };
    }
    
    // 创建上传任务
    const taskId = generateTaskId();
    const task = {
      taskId,
      createdAt: new Date().toISOString(),
      status: 'uploading',
      totalFiles: audioFiles.length,
      completedFiles: 0,
      failedFiles: 0,
      totalSize: audioFiles.reduce((sum, file) => sum + file.size, 0),
      uploadedSize: 0,
      files: audioFiles.map(file => ({
        name: file.name,
        path: file.webkitRelativePath || file.name,
        size: file.size,
        status: 'pending',
        uploadedSize: 0,
        totalSize: file.size
      })),
      options: { ...folderImportOptions.value }
    };
    
    // 保存任务
    saveLocalTask(task);
    uploadTasks.value = getLocalTasks();
    
    // 逐个上传文件
            for (let i = 0; i < audioFiles.length; i++) {
              const file = audioFiles[i];
              const fileItem = task.files[i];
              
              console.log('Processing audio file:', file.name);
              const formData = new FormData();
              formData.append('file', file);
              
              let relativePath = file.webkitRelativePath || file.name;
              if (rootFolderName && !relativePath.startsWith(rootFolderName)) {
                relativePath = `${rootFolderName}/${relativePath}`;
              }
              
              formData.append('relativePath', relativePath);
              formData.append('taskId', taskId);
              formData.append('audioType', folderImportOptions.value.audioType || 'dry');
              formData.append('sourceLanguage', folderImportOptions.value.sourceLanguage || '');
              
              // 添加翻译方向ID（如果是提示词音频且有选择）
              if (folderImportOptions.value.audioType === 'prompt' && folderImportOptions.value.translationDirectionId) {
                formData.append('translationDirectionId', folderImportOptions.value.translationDirectionId);
              }
              
              // 添加测试用例生成选项
              if (folderImportOptions.value.createTestCase) {
                formData.append('createTestCase', 'true');
                formData.append('testType', folderImportOptions.value.testType);
                if (folderImportOptions.value.playbackDeviceId) {
                  formData.append('defaultPlaybackDeviceId', folderImportOptions.value.playbackDeviceId.toString());
                }
                // API测试不需要配置声压级，只有E2E测试需要
                if (folderImportOptions.value.testType === 'e2e') {
                  formData.append('defaultSpl', folderImportOptions.value.spl.toString());
                }
                const groupName = getFolderImportGroupName(rootFolderName);
                if (groupName) {
                  formData.append('testCaseGroupName', groupName);
                }
                // 确保生成的用例直接继承音频标签
                formData.append('inheritTags', 'true');
              }
              
              try {
                fileItem.status = 'uploading';
                saveLocalTask(task);
                
                const response = await audiosApi.upload(formData, { signal: abortController?.signal });
                fileItem.status = 'completed';
                fileItem.uploadedSize = fileItem.size;
                task.completedFiles++;
                task.uploadedSize += fileItem.size;
                importedCount++;
                
                if (response.testCaseId) {
                  testCaseCount++;
                }
              } catch (err) {
                console.error('Failed to upload', file.name, err);
                fileItem.status = 'failed';
                fileItem.errorMessage = err.message || '未知错误';
                fileItem.errorCode = err.code || 500;
                task.failedFiles++;
              }
              
              // 更新进度
              uploadProgress.value = Math.floor((task.uploadedSize / task.totalSize) * 90);
              saveLocalTask(task);
            }
    
    // 上传完成，更新任务状态
    task.status = 'completed';
    saveLocalTask(task);
    uploadTasks.value = getLocalTasks();
    
    return { importedCount, testCaseCount };
  }
}

// 批量删除
async function batchDelete() {
  console.log(`AudioImport: 批量删除 - 选中 ${selectedAudios.value.length} 个音频文件`);
  if (selectedAudios.value.length === 0) return;
  if (confirm(`确定要删除选中的 ${selectedAudios.value.length} 个音频文件吗？`)) {
    try {
      await audiosApi.batchAction('delete', selectedAudios.value);
      const deletedCount = selectedAudios.value.length;
      selectedAudios.value = [];
      fetchAudios();
      // 显示删除结果模态框
  showDeleteResultModal.value = true;
  deleteResult.value = {
    success: true,
    message: '批量删除成功',
    count: deletedCount
  };
    } catch (err) {
      // 显示删除结果模态框
  showDeleteResultModal.value = true;
  deleteResult.value = {
    success: false,
    message: '批量删除失败: ' + err.message,
    count: 0
  };
    }
  }
}

