// 获取翻译方向列表
async function fetchTranslationDirections() {
  try {
    const { audiosApi } = await import('../../utils/api');
    const response = await audiosApi.getDirections();
    // 后端返回格式为 { items: [], total: 0 }
    // 转换字段名：驼峰命名 -> 下划线命名
    const directions = response.items || [];
    translationDirections.value = directions.map(dir => ({
      id: dir.id,
      source_language: dir.sourceLanguage || dir.source_language,
      target_language: dir.targetLanguage || dir.target_language,
      description: dir.description
    }));
  } catch (err) {
    console.error('获取翻译方向列表失败:', err);
    translationDirections.value = [];
  }
}

// 获取根文件夹名称
function getRootFolderName() {
  if (selectedFilesForUpload.value.length === 0) {
    return '';
  }
  
  const fileItem = selectedFilesForUpload.value[0];
  
  if (typeof fileItem === 'string') {
    // Electron环境：文件路径
    const pathParts = fileItem.split(/[\\/]/);
    if (pathParts.length > 0) {
      return pathParts[0] || '';
    }
  } else if (fileItem.webkitRelativePath) {
    // 浏览器环境：webkitRelativePath
    const pathParts = fileItem.webkitRelativePath.split('/');
    if (pathParts.length > 0) {
      return pathParts[0];
    }
  }
  
  return '';
}

// 获取有效的分组名称
function getEffectiveGroupName() {
  if (!uploadOptions.value.createTestCase) {
    return null;
  }
  
  if (uploadOptions.value.groupNameType === 'custom' && uploadOptions.value.customGroupName.trim()) {
    return uploadOptions.value.customGroupName.trim();
  }
  
  return getRootFolderName() || '音频上传生成';
}

// 获取批量导入的有效分组名称
function getFolderImportGroupName(rootFolderName) {
  if (!folderImportOptions.value.createTestCase) {
    return null;
  }
  
  if (folderImportOptions.value.groupNameType === 'custom' && folderImportOptions.value.customGroupName.trim()) {
    return folderImportOptions.value.customGroupName.trim();
  }
  
  return rootFolderName || '音频上传生成';
}

// 纯 JavaScript 实现的 path.basename
function pathBasename(filePath) {
  if (!filePath) return '';
  const normalizedPath = filePath.replace(/\\/g, '/');
  const parts = normalizedPath.split('/');
  return parts[parts.length - 1] || '';
}

// 获取播放设备列表
async function fetchPlaybackDevices() {
  try {
    const { playbackApi } = await import('../../utils/api');
    const data = await playbackApi.getAll();
    playbackDevices.value = data.items || [];
  } catch (err) {
    console.error('获取播放设备列表失败:', err);
    playbackDevices.value = [];
  }
}



// 更新统计信息
function updateStats() {
  // 基于当前上传的任务，预估并更新统计信息
  // 注意：这是基于前端数据的实时更新，上传完成后仍会从服务器获取准确数据
  
  if (currentTask.value) {
    // 获取当前任务的完成文件数
    const completedFiles = currentTask.value.completedFiles || 0;
    const failedFiles = currentTask.value.failedFiles || 0;
    
    // 计算当前任务已完成的文件大小
    const completedSize = currentTask.value.files?.filter(f => f.status === 'completed').reduce((sum, file) => sum + file.size, 0) || 0;
    
    // 计算当前任务的总文件大小
    const taskTotalSize = currentTask.value.totalSize || 0;
    
    // 解析当前统计中的总大小，移除单位并转换为字节
    let currentTotalSizeBytes = 0;
    if (stats.value.totalSize) {
      const sizeMatch = stats.value.totalSize.match(/([\d.]+)\s*(\w+)/);
      if (sizeMatch) {
        const size = parseFloat(sizeMatch[1]);
        const unit = sizeMatch[2].toLowerCase();
        const unitMultipliers = {
          'b': 1,
          'kb': 1024,
          'mb': 1024 * 1024,
          'gb': 1024 * 1024 * 1024,
          'tb': 1024 * 1024 * 1024 * 1024
        };
        currentTotalSizeBytes = size * (unitMultipliers[unit] || 1);
      }
    }
    
    // 保存原始任务的初始统计值，用于计算增量
    if (!currentTask.value.initialStats) {
      currentTask.value.initialStats = {
        totalFiles: stats.value.totalFiles || 0,
        todayUploads: stats.value.todayUploads || 0,
        totalSizeBytes: currentTotalSizeBytes
      };
    }
    
    // 计算增量
    const initialStats = currentTask.value.initialStats;
    const filesIncrement = completedFiles;
    const sizeIncrement = completedSize;
    
    // 计算新的总大小（字节）
    const newTotalSizeBytes = initialStats.totalSizeBytes + sizeIncrement;
    
    // 更新统计信息
    stats.value = {
      ...stats.value,
      // 实时更新总文件数和今日上传数
      totalFiles: initialStats.totalFiles + filesIncrement,
      todayUploads: initialStats.todayUploads + filesIncrement,
      // 实时更新总文件大小，使用formatFileSize函数确保格式正确
      totalSize: formatFileSize(newTotalSizeBytes)
    };
  }
}

// 获取音频数据
async function fetchAudios(options = {}) {
  loading.value = true;
  error.value = null;
  try {
    const params = {
      page: currentPage.value,
      perPage: pageSize.value,
      keyword: searchQuery.value,
      format: filters.value.format !== 'all' ? filters.value.format : '',
      sampleRate: filters.value.sampleRate !== 'all' ? filters.value.sampleRate : '',
      duration: filters.value.duration !== 'all' ? filters.value.duration : '',
      audioType: filters.value.audioType !== 'all' ? filters.value.audioType : ''
    };
    
    const data = await audiosApi.getAll(params, options);
    
    audios.value = data.items || [];
    stats.value = data.stats || {
      totalFiles: data.total || 0,
      totalSize: '0 MB',
      totalDuration: '0:00',
      todayUploads: 0
    };
    
    // 更新标签云
    updateAllTags();
  } catch (err) {
    console.error('Failed to fetch audios:', err);
    if (err.name !== 'AbortError') {
      error.value = '获取音频列表失败';
    }
  } finally {
    loading.value = false;
  }
}

// 格式化文件大小，实现自适应显示
function formatFileSize(size) {
  if (typeof size === 'string') {
    // 如果已经是格式化后的字符串，直接返回
    return size;
  }
  
  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  let currentSize = parseInt(size) || 0;
  let unitIndex = 0;
  
  while (currentSize >= 1024 && unitIndex < units.length - 1) {
    currentSize /= 1024;
    unitIndex++;
  }
  
  return `${currentSize.toFixed(2)} ${units[unitIndex]}`;
}

// 删除本地任务（供模板使用）
function removeLocalTask(taskId) {
  try {
    const tasks = getLocalTasks();
    const filteredTasks = tasks.filter(t => t.taskId !== taskId);
    localStorage.setItem('audioUploadTasks', JSON.stringify(filteredTasks));
    uploadTasks.value = filteredTasks;
  } catch (error) {
    console.error('删除本地任务失败:', error);
  }
}

// 格式化音频时长，实现自适应显示
function formatDuration(duration) {
  if (typeof duration === 'string') {
    // 如果已经是格式化后的字符串，直接返回
    return duration;
  }
  
  const seconds = parseFloat(duration) || 0;
  
  if (seconds < 60) {
    // 小于1分钟，显示秒
    return `${seconds.toFixed(1)}s`;
  } else if (seconds < 3600) {
    // 小于1小时，显示分:秒
    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = Math.floor(seconds % 60);
    return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}`;
  } else {
    // 大于等于1小时，显示时:分:秒
    const hours = Math.floor(seconds / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    const remainingSeconds = Math.floor(seconds % 60);
    return `${hours}:${minutes.toString().padStart(2, '0')}:${remainingSeconds.toString().padStart(2, '0')}`;
  }
}

// 处理文件路径，只显示静态资源路径之后的部分
function formatFilePath(path) {
  if (!path) return '';
  
  // 处理Windows风格路径，转换为统一的斜杠格式
  const normalizedPath = path.replace(/\\/g, '/');
  
  // 匹配后端静态资源目录后的部分，包括/audios/...
  const audioPathPattern = /\/static\/audios\/(.*)/i;
  const match = normalizedPath.match(audioPathPattern);
  if (match && match[1]) {
    // 如果匹配到，只返回/audios/后面的部分
    return `/audios/${match[1]}`;
  }
  
  // 尝试匹配不带/static前缀的audios目录
  const altAudioPathPattern = /\/audios\/(.*)/i;
  const altMatch = normalizedPath.match(altAudioPathPattern);
  if (altMatch && altMatch[1]) {
    // 如果匹配到，返回完整的/audios/...路径
    return `/audios/${altMatch[1]}`;
  }
  
  // 如果没有匹配到，返回原路径的后半部分（文件名或相对路径）
  const pathParts = normalizedPath.split('/');
  const fileNameIndex = pathParts.lastIndexOf('audios');
  if (fileNameIndex !== -1 && fileNameIndex < pathParts.length - 1) {
    // 返回从audios开始的路径
    return pathParts.slice(fileNameIndex).join('/');
  }
  
  // 最后的备用方案，返回文件名
  return pathParts[pathParts.length - 1];
}

// 计算过滤后的音频列表
const filteredAudios = computed(() => {
  let result = audios.value.map(audio => {
    // 处理不同格式的标签数据
    let audioTags = [];
    // 确保audio和audio.tags存在
    if (audio) {
      if (Array.isArray(audio.tags)) {
        audioTags = audio.tags;
      } else if (Array.isArray(audio.tag)) {
        audioTags = audio.tag;
      } else if (typeof audio.tags === 'string' && audio.tags) {
        audioTags = audio.tags.split(',').map(tag => tag.trim());
      } else if (typeof audio.tag === 'string' && audio.tag) {
        audioTags = audio.tag.split(',').map(tag => tag.trim());
      }
      // 确保audioTags是数组
      if (!Array.isArray(audioTags)) {
        audioTags = [];
      }
    }
    
    return {
      ...audio,
      // 适配前端模板使用的属性名
      filename: audio?.name || audio?.filename || '', // 模板使用 filename，后端返回 name 或 filename
      path: formatFilePath(audio?.filePath || audio?.path), // 模板使用 path，后端返回 filePath 或 path
      size: formatFileSize(audio?.size), // 格式化文件大小，实现自适应显示
      duration: formatDuration(audio?.duration), // 格式化音频时长，实现自适应显示
      type: audio?.audioType || audio?.type || 'dry', // 模板使用 type，后端返回 audioType 或 type
      sourceLanguage: audio?.sourceLanguage || audio?.source_language || '', // 模板使用 sourceLanguage，后端返回 sourceLanguage 或 source_language
      status: audio?.status || 'active', // 模板使用 status，后端可能没有返回
      // 统一标签格式为数组
      tags: audioTags || []
    }; 
  }); 
  
  // 标签云过滤
  if (selectedTags.value.length > 0) {
    result = result.filter(audio => {
      // 确保audio.tags是数组
      const tags = Array.isArray(audio.tags) ? audio.tags : [];
      return selectedTags.value.every(tag => tags.includes(tag));
    });
  }
  
  // 本地搜索过滤，实现实时搜索效果
  if (searchQuery.value.trim()) {
    const keyword = searchQuery.value.toLowerCase().trim();
    result = result.filter(audio => {
      // 检查文件名、标签、ASR文本
      const filenameMatch = (audio?.filename || '').toLowerCase().includes(keyword);
      // 确保audio.tags是数组
      const tags = Array.isArray(audio.tags) ? audio.tags : [];
      const tagsMatch = tags.some(tag => tag.toLowerCase().includes(keyword));
      const asrTextMatch = (audio?.asrText || audio?.asr_text || '').toLowerCase().includes(keyword);
      
      return filenameMatch || tagsMatch || asrTextMatch;
    });
  }
  
  return result;
});

// 将路径转换为文件夹树结构
const folderTree = computed(() => {
  const root = { name: '根目录', path: '/', folders: {}, files: [] };
  
  filteredAudios.value.forEach(audio => {
    // 解析音频路径，构建文件夹树
    const pathParts = audio.path.split('/').filter(part => part);
    let current = root;
    
    // 构建文件夹路径
    pathParts.slice(0, -1).forEach(part => {
      if (!current.folders[part]) {
        current.folders[part] = {
          name: part,
          path: `${current.path}${part}/`,
          folders: {},
          files: []
        };
      }
      current = current.folders[part];
    });
    
    // 添加文件到当前文件夹
    current.files.push(audio);
  });
  
  return root;
});

// 辅助函数：将文件夹对象转换为数组格式
function flattenFolders(folder) {
  return {
    ...folder,
    folders: Object.values(folder.folders).map(flattenFolders)
  };
}

// 扁平化的文件夹树结构，便于模板使用
const flattenedFolderTree = computed(() => {
  return flattenFolders(folderTree.value);
});

// 切换标签选择
function toggleTag(tag) {
  console.log(`AudioImport: 切换标签选择 - ${tag}`);
  const index = selectedTags.value.indexOf(tag);
  if (index === -1) {
    selectedTags.value.push(tag);
  } else {
    selectedTags.value.splice(index, 1);
  }
  filterAudios();
}

// 计算总页数
const totalPages = computed(() => {
  // 当有搜索关键词时，基于本地过滤结果计算总页数
  // 否则基于后端返回的总文件数计算
  if (searchQuery.value.trim()) {
    return Math.ceil(filteredAudios.value.length / pageSize.value) || 1;
  }
  return Math.ceil((stats.value.totalFiles || 0) / pageSize.value) || 1;
});

// 切换视图模式
function switchView(mode) {
  console.log(`AudioImport: 切换视图模式 - ${mode}`);
  view_mode.value = mode;
}

// 检查文件夹是否展开
function isFolderOpen(folder) {
  return expandedFolders.value.includes(folder.path);
}

// 切换文件夹展开/折叠状态
function toggleFolder(folder) {
  const index = expandedFolders.value.indexOf(folder.path);
  if (index === -1) {
    expandedFolders.value.push(folder.path);
  } else {
    expandedFolders.value.splice(index, 1);
  }
}

// 防抖函数
function debounce(func, delay) {
  let timer;
  return function() {
    const context = this;
    const args = arguments;
    clearTimeout(timer);
    timer = setTimeout(() => func.apply(context, args), delay);
  };
}

// 搜索音频
const searchAudios = debounce(() => {
  currentPage.value = 1;
  fetchAudios();
}, 300);

// 过滤音频
function filterAudios() {
  currentPage.value = 1;
  fetchAudios();
}

// 应用筛选
function applyFilters() {
  console.log('AudioImport: 应用筛选');
  filterAudios();
}

// 重置筛选
function resetFilters() {
  console.log('AudioImport: 重置筛选');
  filters.value = {
    format: 'all',
    sampleRate: 'all',
    duration: 'all',
    audioType: 'all'
  };
