# 开发环境配置
# Vite 代理目标 — 指向后端 api_gateway
VITE_API_TARGET=http://localhost:5000

# 认证模式：off（关闭，向后兼容）| dev（本地 OAuth）| prod（华为云 OAuth）
# 与后端 Config.AUTH_MODE 保持一致；off 时前端无 token 也可访问
VITE_AUTH_MODE=off

# INT-100：日志实时轮询节流（可选随批）——基础轮询间隔与空闲退避上限（毫秒）
# 空闲任务连续轮询无新日志时间隔按 2 的幂退避至上限，新数据/条件变化恢复基础间隔
# VITE_LOG_POLL_INTERVAL_MS=5000
# VITE_LOG_POLL_IDLE_MAX_MS=30000
