1268  async function autoSaveReferenceParams(param: any, index: number) {
1269    if (!formState.type || !param.code) return
1270    try {
1271      const bodyData = {
1272        code: param.code,
1273        name: param.name,
1274        type: param.type,
1275        annotation_code: param.annotation_code || null,
1276        annotation_format: param.annotation_format || null,
1277        help_text: param.help_text
1278      }
1279      let result
1280      if (param.id) {
1281        result = await algorithmApi.updateReferenceParam(param.id, formState.type, bodyData)
1282      } else {
1283        result = await algorithmApi.createReferenceParam({ ...bodyData, algorithm_type: formState.type })
1284        param.id = result.id
1285      }
1286    } catch (error) {
1287      console.error('自动保存参考参数失败:', error)
1288    }
