1260  async function handleReferenceParamBlur(param: any, index: number) {
1261    if (!formState.type || !param.code) return
1262    if (referenceParamSaveTimeout) clearTimeout(referenceParamSaveTimeout)
1263    referenceParamSaveTimeout = setTimeout(async () => {
1264      await autoSaveReferenceParams(param, index)
1265    }, 1000)
1266  }
