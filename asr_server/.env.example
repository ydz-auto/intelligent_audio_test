# ─── ASR Server (asr_server.py) ───

# 监听地址与端口
ASR_HOST=0.0.0.0
ASR_PORT=10095

# 模型缓存目录（默认存到 ../static/asr_models）
# ASR_CACHE_DIR=D:/some/custom/path

# ─── SenseVoice 模型 ───
ASR_SENSEVOICE_MODEL=iic/SenseVoiceSmall
# 语言: auto|zh|en|ja|ko|...
ASR_SV_LANGUAGE=auto
# 是否启用逆文本正则化（数字/日期等）
ASR_SV_USE_ITN=true

# ─── Silero VAD 参数（出段级真实时间戳）───
# 静默多久算段切分（毫秒）。打断检测建议 200，越小越细但越碎
ASR_SILERO_MIN_SILENCE_MS=200
# 语音检测阈值（0~1，越高越严）
ASR_SILERO_THRESHOLD=0.5
# 最短语音段（毫秒），短于此丢弃
ASR_SILERO_MIN_SPEECH_MS=0
# 语音段两端 padding（毫秒）
ASR_SILERO_SPEECH_PAD_MS=30


# ─── 阿里云百炼云端转写 (asr_transcribe.py) ───

# 阿里云百炼 API Key（必填）
DASHSCOPE_API_KEY=

# 转写模型（默认 fun-asr）
# DASHSCOPE_MODEL=fun-asr

# 语言提示（逗号分隔）
# DASHSCOPE_LANGUAGES=zh,en

# 自定义 API 地址（可选，用于华北2等地域）
# DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
