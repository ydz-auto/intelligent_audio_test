# ─── ASR Server (asr_server.py) ───

# 监听地址与端口
ASR_HOST=0.0.0.0
ASR_PORT=10095

# 模型缓存目录（默认存到 ../static/asr_models）
# ASR_CACHE_DIR=D:/some/custom/path

# ModelScope 模型配置
ASR_MODELSCOPE_MODEL=iic/speech_paraformer-large-vad-punc_asr_nat-zh-cn-16k-common-vocab8404-pytorch
ASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
ASR_PUNC_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch


# ─── 阿里云百炼云端转写 (asr_transcribe.py) ───

# 阿里云百炼 API Key（必填）
DASHSCOPE_API_KEY=

# 转写模型（默认 fun-asr）
# DASHSCOPE_MODEL=fun-asr

# 语言提示（逗号分隔）
# DASHSCOPE_LANGUAGES=zh,en

# 自定义 API 地址（可选，用于华北2等地域）
# DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
