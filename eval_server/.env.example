LLM_JUDGE_API_KEY=
# 全局默认裁判模型（纯文本）
LLM_JUDGE_DEFAULT_MODEL=MiniMax-M2.7-mm
# 各维度独立模型（可选，未配置回退 LLM_JUDGE_DEFAULT_MODEL）
# LLM_JUDGE_MODEL_REJECTION_JUDGE=gpt-4o-audio-preview
# LLM_JUDGE_MODEL_INTERRUPTION_JUDGE=gpt-4o-audio-preview
# LLM_JUDGE_MODEL_HIGH_FREQ_LLM_JUDGE=gpt-4o
# LLM_JUDGE_MODEL_LLM_JUDGE=gpt-5.6-sol
# LLM_JUDGE_MODEL_INTERRUPTION_LLM=gpt-5.6-sol
# LLM_JUDGE_MODEL_FALSE_TAKEOVER=gpt-5.6-sol
ASR_SERVER_URL=http://127.0.0.1:10095
ASR_TIMEOUT=120
# ─── OSS/MinIO（可选，双模式文件传递）───
# 配置后 create_task 的 task_params 中 oss://{category}/{key} 形式的值会自动从
# MinIO 下载为本地路径再参与计算；不配置则仅支持 multipart 上传 / 本地路径。
# 键规则与主项目一致：S3 key = {OSS_KEY_PREFIX}/{category}/{key}
# OSS_ENDPOINT=http://minio:9000
# OSS_ACCESS_KEY=minio
# OSS_SECRET_KEY=minio123
# OSS_BUCKET_NAME=intelligent-audio-test
# OSS_KEY_PREFIX=intelligent_audio_test
# OSS_REGION=us-east-1
