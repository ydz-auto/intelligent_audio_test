# ─── ASR 服务 ───
# 远程 ASR 服务地址（默认 http://127.0.0.1:10095）
# ASR_SERVER_URL=http://127.0.0.1:10095
# ASR 请求超时秒数（默认 120）
# ASR_TIMEOUT=120
# ASR 结果 JSON 本地保存根目录（留空则保存到 wav 同目录）
# 设置后 JSON 会保存到 {ASR_JSON_OUTPUT_DIR}/pcm_case/pcm_case/{case_id}/{session_id}/ 下
# ASR_JSON_OUTPUT_DIR=E:\w60085971\asr_results

# ─── LLM Judge（打断指标可选大模型评估 / llm_judge 维度）───
# 服务地址：https://az.gptplus5.com/ （OpenAI 兼容代理，POST /v1/chat/completions）
# 认证方式：Authorization: Bearer <LLM_JUDGE_API_KEY>
#
# API Key（必填，到 https://az.gptplus5.com/ 控制台获取后填入下方）
LLM_JUDGE_API_KEY=

# 接口 base URL（默认即下方值，留空用默认；自定义地域可改）
# LLM_JUDGE_API_BASE=https://az.gptplus5.com/v1

# 默认模型（gpt-4o 在 AZ 站 default 分组无渠道，实测改用 gpt-4o-mini）
# 实测可用：gpt-4o-mini / gpt-4.1 / gpt-4.1-mini / deepseek-chat / gpt-5-mini / qwen-plus
# 注意：本系统请求带 response_format=json_object，勿用 deepseek-r1（推理模型输出 CoT 会破坏 JSON 解析）
LLM_JUDGE_DEFAULT_MODEL=gemini-3.7-flash

# 最大输出 token 数（默认 4096）
# LLM_JUDGE_MAX_TOKENS=4096

# 采样温度，评判场景建议低温（默认 0.1）
# LLM_JUDGE_TEMPERATURE=0.1

# 请求超时（秒）
# LLM_JUDGE_TIMEOUT=120
